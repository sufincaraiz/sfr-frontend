generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Geographic hierarchy ────────────────────────────────────────────────────

model Municipality {
  id                  String     @id @default(uuid())
  slug                String     @unique
  name                String
  province            String     @default("Cundinamarca") // departamento
  demand_score        Int        @default(0)
  // ── Contenido editable desde el admin (migrado desde municipios-data.ts) ──
  provincia           String?    @default("Gualivá") // subregión/provincia
  distancia_bogota_km Int?
  tiempo_bogota_min   Int?
  altitud_msnm        Int?
  temp_min            Int?
  temp_max            Int?
  descripcion_seo     String?    @db.Text
  meta_description    String?    @db.Text // meta description SEO (~150 car.); vacío = autogenerada
  historia            String?    @db.Text
  clima               String?    @db.Text
  turismo             String?    @db.Text
  /// Qué revisar ANTES de comprar aquí: acceso, agua, uso del suelo, qué tipo
  /// de inmueble se consigue. Sustituye a `inversion`, que preguntaba «por qué
  /// invertir aquí» y por tanto presuponía la respuesta — la novena forma de
  /// esconderse, en el nombre de la columna. Sin precios, sin horizontes, sin
  /// comparaciones entre municipios.
  antes_de_comprar    String?    @db.Text
  og_image            String? // imagen del hero
  geo_lat             Float?
  geo_lng             Float?
  wikipedia_url       String?
  faqs                Json? // [{ question, answer }]
  tour360_url         String? // enlace del recorrido 360 del parque principal (Panoee)
  oculto              Boolean    @default(false)
  updated_at          DateTime   @default(now()) @updatedAt
  veredas             Vereda[]
  properties          Property[]

  @@map("municipalities")
}

model Vereda {
  id              String       @id @default(uuid())
  slug            String
  name            String
  municipality_id String
  lat             Float?
  lng             Float?
  municipality    Municipality @relation(fields: [municipality_id], references: [id])
  properties      Property[]

  @@unique([slug, municipality_id])
  @@map("veredas")
}

// ─── Core ────────────────────────────────────────────────────────────────────

model Property {
  id                String               @id @default(uuid())
  slug              String               @unique
  /// Tipo FÍSICO del inmueble. «condominio» ya no es un tipo: era el régimen
  /// de propiedad colándose en el campo que describe qué es el bien, y por eso
  /// un lote y una casa dentro del mismo condominio caían en la misma bolsa.
  /// El régimen vive ahora en `en_condominio`.
  type              String // finca | lote | casa | apartamento | local
  /// Régimen de propiedad horizontal: el inmueble está dentro de un condominio
  /// o conjunto cerrado. Es ORTOGONAL al tipo — hay lotes en condominio y casas
  /// en condominio, y son búsquedas distintas.
  en_condominio     Boolean              @default(false)
  transaction_type  String               @default("venta")
  municipality_id   String
  vereda_id         String?
  address_visible   String?
  price_cop         BigInt
  area_lot_m2       Float?
  area_built_m2     Float?
  bedrooms          Int                  @default(0)
  bathrooms         Int                  @default(0)
  parking           Int                  @default(0)
  year_built        Int?
  status            String               @default("available") // available | reserved | sold
  geo_lat           Float?
  geo_lng           Float?
  published_at      DateTime             @default(now())
  updated_at        DateTime             @updatedAt
  // SEO / content
  title             String?
  short_description String?
  description       String?
  meta_title        String?
  meta_description  String?
  // Media embeds
  video_url         String?
  virtual_tour_url  String?
  modelo3d_url      String? // URL a un modelo 3D .glb (fotogrametría con dron)
  // Relations
  municipality      Municipality         @relation(fields: [municipality_id], references: [id])
  vereda            Vereda?              @relation(fields: [vereda_id], references: [id])
  media             PropertyMedia[]
  features          PropertyFeature[]
  leads             Lead[]
  visitas           Visita[]
  enlacesVisitantes EnlaceVisitantes[]
  ingresos          Ingreso[]
  egresos           Egreso[]
  custodias         MovimientoCustodia[]

  @@index([municipality_id, status, price_cop])
  @@index([vereda_id, status])
  @@index([type, status])
  @@map("properties")
}

/// Catálogo editable de tipos de inmueble. `slug` es exactamente el string que
/// se guarda en `Property.type`, así que la tabla es puramente descriptiva: no
/// hay FK y los datos existentes siguen funcionando sin tocarse. Sirve para
/// alimentar los selectores (admin y filtros públicos), poner etiquetas bonitas
/// y permitir que el admin agregue un tipo nuevo desde el formulario ("Otro…").
model TipoPropiedad {
  id         String   @id @default(uuid())
  slug       String   @unique // valor guardado en Property.type (ej. "lote-campestre")
  label      String // singular, para fichas y chips ("Lote campestre")
  plural     String? // para títulos y headings ("Lotes campestres"); vacío = label + "s"
  orden      Int      @default(100)
  oculto     Boolean  @default(false) // fuera de los selectores, sin borrar el histórico
  updated_at DateTime @default(now()) @updatedAt

  @@map("property_types")
}

model PropertyFeature {
  id            String   @id @default(uuid())
  property_id   String
  feature_key   String
  feature_value String
  property      Property @relation(fields: [property_id], references: [id], onDelete: Cascade)

  @@map("property_features")
}

model PropertyMedia {
  id                String   @id @default(uuid())
  property_id       String
  type              String // image | video | tour360
  tour360_type      String? // self_hosted | embed
  tour360_embed_url String?
  url               String
  order             Int      @default(0)
  alt_text          String   @default("")
  is_primary        Boolean  @default(false)
  property          Property @relation(fields: [property_id], references: [id], onDelete: Cascade)

  @@map("property_media")
}

// ─── Agents ─────────────────────────────────────────────────────────────────

model Agent {
  id       String  @id @default(uuid())
  name     String
  slug     String  @unique
  photo    String?
  license  String?
  whatsapp String
  email    String  @unique
  leads    Lead[]

  @@map("agents")
}

// ─── Leads ──────────────────────────────────────────────────────────────────

enum LeadQualification {
  SIN_CALIFICAR
  CALIENTE
  TIBIO
  FRIO
  VACIO
  DESCARTADO
}

enum LeadPipeline {
  NUEVO
  CONTACTADO
  VISITA_AGENDADA
  EN_NEGOCIACION
  CERRADO_GANADO
  CERRADO_PERDIDO
}

model Lead {
  id                String            @id @default(uuid())
  property_id       String?
  name              String
  phone             String
  email             String
  channel           String            @default("web")
  message           String?
  utm_source        String?
  utm_medium        String?
  utm_campaign      String?
  created_at        DateTime          @default(now())
  status            String            @default("new")
  assigned_agent_id String?
  // Mac agent fields
  qualification     LeadQualification @default(SIN_CALIFICAR)
  budgetMin         Int?
  budgetMax         Int?
  interestType      String?
  interestZone      String?
  timeframe         String?
  financing         String?
  agentNotes        String?           @db.Text
  source            String?
  portalAdId        String?
  pipeline          LeadPipeline      @default(NUEVO)
  nextAction        String?
  nextActionDate    DateTime?
  lastContactAt     DateTime?
  consentAt         DateTime? // Ley 1581/2012: 1ª vez que se capta un dato de contacto
  summary           String?           @db.Text // Resumen de la conversación para el asesor (se genera una vez, al captar el lead)
  summaryAt         DateTime? // Cuándo se generó el resumen
  property          Property?         @relation(fields: [property_id], references: [id], onDelete: SetNull)
  agent             Agent?            @relation(fields: [assigned_agent_id], references: [id])
  conversations     Conversation[]
  contacto          Contacto?

  @@map("leads")
}

// ─── CRM: contactos con embudo de ventas ─────────────────────────────────────
model Contacto {
  id                  String    @id @default(uuid())
  nombre              String
  telefono            String?
  email               String?
  tipo                String    @default("comprador") // comprador | vendedor | arrendatario
  interes             String?   @db.Text // qué busca
  etapa               String    @default("nuevo") // nuevo | contactado | en_seguimiento | cerrado
  proximo_seguimiento DateTime?
  origen              String    @default("manual") // manual | lead-web | referido | otro
  notas               String?   @db.Text
  lead_id             String?   @unique // si vino de un Lead web (evita doble conversión)
  lead                Lead?     @relation(fields: [lead_id], references: [id], onDelete: SetNull)
  created_by          String? // id del usuario (Admin) que lo cargó — conserva historial
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  tercero Tercero?

  @@index([etapa])
  @@index([proximo_seguimiento])
  @@map("contactos")
}

// ─── Agent conversations ─────────────────────────────────────────────────────

enum Channel {
  WEB
  WHATSAPP
  TELEGRAM
  APP
}

enum ConvStatus {
  ACTIVE
  ESCALATED
  CLOSED
}

enum MsgRole {
  USER
  ASSISTANT
}

model Conversation {
  id              String     @id @default(cuid())
  channel         Channel    @default(WEB)
  externalId      String
  leadId          String?
  lead            Lead?      @relation(fields: [leadId], references: [id])
  status          ConvStatus @default(ACTIVE)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  // Contabilidad de tokens y topes de consumo (agente Mac)
  tokensIn        Int        @default(0)
  tokensOut       Int        @default(0)
  turnCount       Int        @default(0)
  offTopicCount   Int        @default(0)
  closedAt        DateTime?
  closedReason    String?
  // 1ª (y única) escalación al asesor humano: evita notificaciones ilimitadas por sesión.
  escalatedAt     DateTime?
  // Escalamiento al modelo experto (Opus). Se contabilizan APARTE de los tokens de
  // Haiku porque el costo por token es muy distinto y hay que verlos por separado.
  expertCallCount Int        @default(0)
  expertTokensIn  Int        @default(0)
  expertTokensOut Int        @default(0)
  messages        Message[]

  @@unique([channel, externalId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  role           MsgRole
  content        String       @db.Text
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@map("messages")
}

/// Base de conocimiento de Mac: fichas de información que se inyectan en su
/// prompt en cada conversación (promociones, formas de pago, FAQ, políticas).
/// Se administra en /admin/mac — no requiere desplegar para actualizarse.
model MacKnowledge {
  id            String    @id @default(uuid())
  titulo        String
  contenido     String    @db.Text
  categoria     String    @default("General")
  activo        Boolean   @default(true)
  orden         Int       @default(0)
  /// DIA PURO: sale de un <input type="date">. Ver src/lib/dia-colombia.ts.
  vigente_hasta DateTime? @db.Date // opcional: se ignora automáticamente al vencer (promos)
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  @@index([activo, orden])
  @@map("mac_knowledge")
}

// ─── Admin ──────────────────────────────────────────────────────────────────

model Admin {
  id         String    @id @default(uuid())
  email      String    @unique
  password   String
  nombre     String
  role       String    @default("admin") // admin | asistente_crm | autor_blog
  activo     Boolean   @default(true) // desactivar (no borrar) para conservar historial
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  articulos  Article[]

  @@map("admins")
}

// ─── Content ────────────────────────────────────────────────────────────────

model Article {
  id               String    @id @default(uuid())
  slug             String    @unique
  title            String
  excerpt          String?
  content          String    @db.Text
  cover_image_url  String?
  published_at     DateTime?
  updated_at       DateTime  @updatedAt
  meta_title       String?
  meta_description String?
  // Aportes de la comunidad (blog colaborativo)
  author_name      String?
  author_photo_url String?
  author_email     String?
  // Autor con cuenta propia (rol autor_blog). null = artículo MDX/comunidad/legacy.
  author_id        String?
  autor            Admin?    @relation(fields: [author_id], references: [id], onDelete: SetNull)
  created_at       DateTime  @default(now())

  @@index([author_id])
  @@map("articles")
}

/// Registro de visitas a inmuebles (control de ingreso y seguridad).
/// Contiene datos personales sensibles (cédula), así que cada fila guarda la
/// PRUEBA del consentimiento: el momento exacto y las dos autorizaciones por
/// separado, como exige la Ley 1581 de 2012 (Habeas Data).
model Visita {
  id                    String    @id @default(uuid())
  createdAt             DateTime  @default(now())
  nombresCompletos      String
  cedula                String
  // ── Inmueble visitado ──
  // `propiedadId` apunta al catálogo cuando el visitante elige una propiedad
  // nuestra. `inmuebleReferencia` SIEMPRE se llena: guarda el título elegido o
  // el texto libre si marcó "Otro". Así el registro sigue siendo legible aunque
  // la propiedad se borre del catálogo (la FK queda en NULL, el título no).
  propiedadId           String?
  propiedad             Property? @relation(fields: [propiedadId], references: [id], onDelete: SetNull)
  inmuebleReferencia    String // título de la propiedad elegida, o texto libre si esOtro
  esOtro                Boolean   @default(false) // inmueble no listado (de un colega)
  correo                String
  celular               String
  municipioOrigen       String
  // ── Prueba del consentimiento ──
  consentAt             DateTime // cuándo aceptó
  consentPolitica       Boolean   @default(false) // casilla 1: política de tratamiento
  consentControlIngreso Boolean   @default(false) // casilla 2: control de ingreso y seguridad
  ip                    String? // trazabilidad de seguridad; puede faltar

  @@index([createdAt])
  @@index([cedula])
  @@index([propiedadId]) // agrupación por inmueble en /admin/visitas
  @@map("visitas")
}

model Business {
  id              String   @id @default(uuid())
  nombre          String
  imagen_url      String? // legacy: portada única (respaldo). Ahora se usa `imagenes`.
  imagenes        String[] @default([]) // hasta 5 fotos; imagenes[0] = portada
  descripcion     String? // descripción corta
  categoria       String // Restaurante | Ferretería | Droguería | Vivero | Otros
  municipio       String   @default("La Vega")
  whatsapp        String?
  domicilios      Boolean  @default(false)
  google_maps_url String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@index([categoria])
  @@index([municipio])
  @@map("businesses")
}

model PageContent {
  id         String   @id @default(uuid())
  key        String   @unique
  data       Json
  updated_at DateTime @updatedAt

  @@map("page_content")
}

model Redirect {
  id          String  @id @default(uuid())
  source      String  @unique
  destination String
  permanent   Boolean @default(true)

  @@map("redirects")
}

model SearchLog {
  id         String   @id @default(uuid())
  query      String?
  tipo       String?
  municipio  String?
  precio_max BigInt?
  results    Int      @default(0)
  created_at DateTime @default(now())

  @@map("search_logs")
}

// ─────────────────────────────────────────────────────────────────────────────
// Enlace privado para que el DUEÑO de una propiedad vea quién la visitó.
//
// La URL lleva un token largo aleatorio (la parte secreta) y encima pide un PIN
// que define el admin. Dos factores porque detrás hay cédulas: si el enlace se
// reenvía por WhatsApp sin querer, el PIN todavía protege los datos.
//
// El PIN se guarda SOLO hasheado con bcrypt — no hay forma de recuperarlo ni de
// mostrarlo. Si el dueño lo olvida, el admin genera un enlace nuevo.
//
// onDelete: Cascade (a diferencia de Visita, que usa SetNull): si la propiedad
// se borra del catálogo, el enlace del dueño pierde todo sentido y debe morir
// con ella. Lo que se preserva es el registro de la visita, no el acceso.
// ─────────────────────────────────────────────────────────────────────────────
model EnlaceVisitantes {
  id               String    @id @default(uuid())
  createdAt        DateTime  @default(now())
  propiedadId      String
  propiedad        Property  @relation(fields: [propiedadId], references: [id], onDelete: Cascade)
  token            String    @unique // 32 bytes aleatorios en base64url; parte secreta de la URL
  pinHash          String // bcrypt del PIN. NUNCA en texto plano
  expiraAt         DateTime // createdAt + 1 año
  revocado         Boolean   @default(false) // apagado manual desde el admin
  ultimoAcceso     DateTime? // trazabilidad: cuándo lo usó el dueño
  intentosFallidos Int       @default(0) // acumulado; al llegar al tope el enlace se bloquea

  @@index([propiedadId])
  @@map("enlaces_visitantes")
}

/// Medición manual de visibilidad en motores de IA.
///
/// Una fila = una consulta hecha a un motor en una fecha. El histórico se
/// construye repitiendo las MISMAS consultas de control (src/lib/visibilidad-ia.ts)
/// en cada ronda: si cambian, las mediciones dejan de ser comparables.
///
/// `consulta_id` y `motor` se guardan como texto, no como relación: su catálogo
/// vive en código a propósito, para que nadie lo edite desde el admin y rompa
/// la línea base.
model MedicionIA {
  id           String   @id @default(uuid())
  /// Id estable de la consulta de control (c01…c11).
  consulta_id  String
  /// Id del motor (chatgpt, gemini, claude, copilot, perplexity, deepseek).
  motor        String
  /// ¿Apareció Su Finca Raíz en la respuesta?
  aparece      Boolean
  /// Posición en la que se menciona (1 = primera). null si no aparece.
  posicion     Int?
  /// Competidores mencionados, en el orden en que aparecen.
  competidores String[]
  /// LO MÁS IMPORTANTE: cómo describió el motor a la marca, literal.
  /// Ahí se ve si resolvió la entidad correcta o la homónima de Rionegro.
  descripcion  String?  @db.Text
  /// Notas libres de quien mide.
  notas        String?  @db.Text
  medido_en    DateTime @default(now())
  medido_por   String?
  /// Commit desplegado en el momento de medir. Lo captura el servidor solo
  /// (VERCEL_GIT_COMMIT_SHA): sin esto, dentro de tres meses no se sabe contra
  /// qué versión del sitio se midió cada fila y la comparación pierde la mitad
  /// de su valor.
  commit_sitio String?
  /// Texto libre de quien mide: «tras retirar el gratis», «antes del reencuadre»…
  version_nota String?

  @@index([consulta_id, motor, medido_en])
  @@map("mediciones_ia")
}

/// Hallazgos de la vigilancia diaria de contenido (cron/vigilancia).
///
/// Existe para que el cron RECUERDE qué ya reportó: sin esto, el mismo hallazgo
/// se avisa cada día idéntico y un lead real se pierde entre las alertas. Cada
/// hallazgo se identifica por su `hash` (de clase+detalle); una corrida solo
/// notifica los NUEVOS o los que sigan abiertos tras N días. Cuando una corrida
/// ya no ve un hash, se marca `resuelto` (se corrigió).
model VigilanciaHallazgo {
  id            String    @id @default(uuid())
  /// sha1(clase  ␀  detalle). Identidad estable del hallazgo.
  hash          String    @unique
  clase         String
  detalle       String    @db.Text
  primero_visto DateTime  @default(now())
  ultimo_visto  DateTime  @default(now())
  /// true cuando una corrida deja de verlo (contenido corregido).
  resuelto      Boolean   @default(false)
  /// Última vez que se avisó por WhatsApp de este hallazgo. null = nunca.
  notificado_en DateTime?

  @@index([resuelto, primero_visto])
  @@map("vigilancia_hallazgos")
}

// ═══════════════════════════════════════════════════════════════════════════
// MÓDULO TRIBUTARIO Y FINANCIERO
//
// PRINCIPIO: ninguna tarifa vive en el código ni en el esquema. Todas son
// parámetros por AÑO FISCAL, cargados desde el panel. Los campos nacen VACÍOS
// (nullable): si falta el parámetro del año, el cálculo se detiene y avisa.
// Es la misma regla del contenido: lo que cambia se deriva, no se escribe.
//
// QUÉ SE GUARDA Y QUÉ SE DERIVA:
//   · Se GUARDA lo que ocurrió: el IVA que se facturó y las retenciones que la
//     contraparte practicó (constan en su comprobante). Eso es un HECHO, no un
//     cálculo nuestro, y puede diferir de lo que calculamos.
//   · Se DERIVA siempre: valor neto, utilidad, bases gravables, totales.
//     Ningún total se persiste.
// ═══════════════════════════════════════════════════════════════════════════

enum TipoDocumento {
  CC
  NIT
  CE
  PPT
  PASAPORTE
  TI
}

enum TipoPersona {
  NATURAL
  JURIDICA
}

enum RolTercero {
  CLIENTE
  PROVEEDOR
  AMBOS
  ASESOR
}

enum EstadoIngreso {
  CAUSADO
  FACTURADO
  COBRADO
  ANULADO
}

/// Quién paga el egreso AL FINAL. No es la categoría (qué se compró), es de
/// quién sale la plata. El tercero es el crítico: un REEMBOLSABLE contado como
/// gasto —y su reembolso como ingreso— infla las dos cifras y hace pagar
/// impuesto sobre plata que no se ganó. Misma trampa que MovimientoCustodia,
/// en el sentido contrario del dinero.
enum NaturalezaEgreso {
  /// Gasto general: internet, papelería, arriendo.
  DEL_NEGOCIO
  /// Gasto propio imputado a una propiedad u operación. Reduce la ganancia
  /// de ESA venta.
  DE_OPERACION
  /// Pagado por cuenta del cliente, que lo va a devolver. NO ES GASTO: es una
  /// cuenta por cobrar. No entra al estado de resultados.
  REEMBOLSABLE
}

/// Solo para egresos REEMBOLSABLE.
enum EstadoReembolso {
  PENDIENTE
  /// El cliente devolvió la plata. Tampoco es ingreso: cancela la cuenta.
  REEMBOLSADO
  /// El cliente no pagó y lo absorbió el negocio: se reclasificó a
  /// DE_OPERACION y desde ese momento SÍ es gasto.
  ASUMIDO
}

/// Naturaleza del dinero recibido que NO es ingreso. Ver MovimientoCustodia.
enum NaturalezaCustodia {
  /// Arras o depósitos recibidos EN NOMBRE DEL VENDEDOR. Nunca son nuestros.
  DINERO_DE_TERCEROS
  /// Anticipo de honorarios propios SIN causación todavía (sin factura).
  ANTICIPO_PROPIO
}

enum EstadoCustodia {
  RECIBIDO
  ENTREGADO
  DEVUELTO
  APLICADO
}

enum RolParticipacion {
  PROPIA
  CORREDOR_EXTERNO
  ASESOR_INTERNO
}

/// Cliente o proveedor con identidad FISCAL. Distinto de `Contacto` (prospecto
/// del CRM): aquí el documento y las banderas del RUT son obligatorias porque
/// determinan qué retención aplica. Se enlaza opcionalmente con el contacto del
/// que salió, para no volver a teclear los datos.
model Tercero {
  id                    String        @id @default(uuid())
  tipo_documento        TipoDocumento
  numero_documento      String
  /// Dígito de verificación del NIT.
  dv                    String?
  /// Nombre completo o razón social.
  nombre                String
  tipo_persona          TipoPersona
  // ── Banderas del RUT. NO se infieren: se capturan del RUT del tercero. ──
  es_responsable_iva    Boolean       @default(false)
  es_autorretenedor     Boolean       @default(false)
  es_gran_contribuyente Boolean       @default(false)
  /// Determina si se aplica la tarifa de declarante o de no declarante.
  es_declarante_renta   Boolean       @default(false)
  regimen               String?
  direccion             String?
  /// Texto libre: el domicilio fiscal puede ser cualquier municipio del país,
  /// no solo los del Gualivá que tiene la tabla `municipalities`.
  municipio             String?
  telefono              String?
  email                 String?
  rol                   RolTercero    @default(CLIENTE)
  /// Puente OPCIONAL con el CRM. Nullable a propósito: un proveedor no es un
  /// contacto, y un contacto no necesita datos de RUT hasta que factura.
  contacto_id           String?       @unique
  contacto              Contacto?     @relation(fields: [contacto_id], references: [id], onDelete: SetNull)
  activo                Boolean       @default(true)
  notas                 String?       @db.Text
  created_at            DateTime      @default(now())
  updated_at            DateTime      @updatedAt

  ingresos            Ingreso[]
  egresos             Egreso[]
  egresosQueReembolsa Egreso[]               @relation("EgresoReembolsa")
  participaciones     DistribucionComision[]
  custodiasRecibidas  MovimientoCustodia[]   @relation("CustodiaOrigen")
  custodiasEntregadas MovimientoCustodia[]   @relation("CustodiaDestino")

  @@unique([tipo_documento, numero_documento])
  @@index([nombre])
  @@index([rol])
  @@map("terceros")
}

/// Parámetros fiscales de UN año. Nacen VACÍOS: el contador los llena.
enum EstadoParametro {
  /// Se guarda incompleto y se retoma. El módulo NO calcula con él.
  BORRADOR
  /// Validado y en uso. Solo se activa cuando están los obligatorios.
  ACTIVO
}

model ParametroFiscal {
  id              String          @id @default(uuid())
  anio            Int             @unique
  /// BORRADOR permite guardar a medias sin romper la guarda: el cálculo exige
  /// ACTIVO. Así se trabaja en el año que viene sin bloquear el actual.
  estado          EstadoParametro @default(BORRADOR)
  /// ¿Somos responsables de IVA ESE año? NULLABLE a propósito: null = sin
  /// decidir, y bloquea la activación. Un `false` por defecto silencioso en un
  /// año donde sí se cruzaron los topes es justo el error que nadie ve.
  /// Con false: no se factura IVA, el IVA pagado es COSTO (no descontable) y
  /// tampoco hay reteIVA en ninguna dirección.
  responsable_iva Boolean?
  /// Valor del UVT del año. Null = sin cargar → el cálculo se detiene.
  uvt             Decimal?        @db.Decimal(14, 2)
  /// Solo obligatoria si responsable_iva = true.
  tarifa_iva      Decimal?        @db.Decimal(5, 2)
  tarifa_reteiva  Decimal?        @db.Decimal(5, 2)
  /// Año cerrado: no se editan sus parámetros ni se registran movimientos.
  cerrado         Boolean         @default(false)
  notas           String?         @db.Text
  /// Procedencia de CADA campo escalar: quién lo cargó, cuándo, de dónde vino
  /// (manual | copia | contador) y si ya se revisó. Forma:
  ///   { uvt?: P, responsable_iva?: P, tarifa_iva?: P, tarifa_reteiva?: P }
  ///   P = { por, en, origen, copiadoDe?, revisado }
  /// Un valor copiado del año anterior o importado del contador nace con
  /// revisado=false y cuenta como PENDIENTE hasta que alguien lo confirme: si
  /// no, «copiar el año anterior» sería una puerta trasera a la guarda.
  procedencia     Json?
  activado_por    String?
  activado_en     DateTime?
  created_at      DateTime        @default(now())
  updated_at      DateTime        @updatedAt

  conceptos  ConceptoRetencion[]
  tarifasIca TarifaIca[]

  @@map("parametros_fiscales")
}

/// Retención por CONCEPTO y año. Tabla, no columnas fijas: los conceptos
/// cambian y no puede exigir migración añadir uno.
model ConceptoRetencion {
  id                   String          @id @default(uuid())
  parametro_id         String
  parametro            ParametroFiscal @relation(fields: [parametro_id], references: [id], onDelete: Cascade)
  /// honorarios | comisiones | servicios | arrendamiento | compras | …
  concepto             String
  label                String
  /// La tarifa depende de si el tercero declara renta.
  tarifa_declarante    Decimal         @db.Decimal(5, 2)
  tarifa_no_declarante Decimal         @db.Decimal(5, 2)
  /// Base mínima EN UVT. 0 = sin base mínima (se retiene desde el primer peso).
  base_minima_uvt      Decimal         @default(0) @db.Decimal(10, 2)
  // ── Procedencia (misma semántica que ParametroFiscal.procedencia) ──
  cargado_por          String?
  cargado_en           DateTime        @default(now())
  /// manual | copia | contador
  origen               String          @default("manual")
  copiado_de_anio      Int?
  /// false = copiado o importado y aún sin confirmar → cuenta como pendiente.
  revisado             Boolean         @default(true)

  @@unique([parametro_id, concepto])
  @@map("conceptos_retencion")
}

/// Tarifa de ICA por municipio y año (por mil). Municipio como texto: se
/// declara donde se genera el ingreso, que puede estar fuera del Gualivá.
model TarifaIca {
  id              String          @id @default(uuid())
  parametro_id    String
  parametro       ParametroFiscal @relation(fields: [parametro_id], references: [id], onDelete: Cascade)
  municipio       String
  /// CIIU al que aplica la tarifa. "" = tarifa general del municipio, sin
  /// distinguir actividad. Aquí «en blanco» SÍ significa «todas»; en un
  /// Ingreso significa lo contrario (no calculable). Ver calculo.ts.
  ciiu            String          @default("")
  tarifa_por_mil  Decimal         @db.Decimal(6, 3)
  cargado_por     String?
  cargado_en      DateTime        @default(now())
  /// manual | copia | contador
  origen          String          @default("manual")
  copiado_de_anio Int?
  /// false = copiada o importada y aún sin confirmar → cuenta como pendiente.
  revisado        Boolean         @default(true)

  @@unique([parametro_id, municipio, ciiu])
  @@map("tarifas_ica")
}

/// Catálogo de líneas de servicio. Tabla y no enum de Prisma: «configurable»
/// y `enum` son incompatibles —añadir un servicio no puede exigir migración—.
model TipoServicio {
  id                          String    @id @default(uuid())
  slug                        String    @unique
  label                       String
  /// Clave hacia ConceptoRetencion. Se guarda el CONCEPTO, nunca la tarifa.
  concepto_retencion_sugerido String?
  genera_iva                  Boolean   @default(true)
  /// Código CIIU del RUT bajo el que se factura esta línea (6820, 5911, 7010,
  /// 6201). null = PENDIENTE de que lo confirme el contador: sin él no se
  /// calcula ICA. No se precarga ninguna suposición.
  ciiu                        String?
  orden                       Int       @default(0)
  activo                      Boolean   @default(true)
  ingresos                    Ingreso[]

  @@map("tipos_servicio")
}

model CategoriaEgreso {
  id                          String   @id @default(uuid())
  nombre                      String   @unique
  /// fijo | variable
  grupo                       String   @default("variable")
  es_deducible_por_defecto    Boolean  @default(true)
  genera_iva_descontable      Boolean  @default(true)
  /// Igual que en TipoServicio: el CONCEPTO de retención, no la tarifa.
  concepto_retencion_sugerido String?
  orden                       Int      @default(0)
  activo                      Boolean  @default(true)
  egresos                     Egreso[]

  @@map("categorias_egreso")
}

model Ingreso {
  id                    String        @id @default(uuid())
  tipo_servicio_id      String
  tipoServicio          TipoServicio  @relation(fields: [tipo_servicio_id], references: [id])
  /// Las comisiones se atan a la propiedad vendida.
  property_id           String?
  property              Property?     @relation(fields: [property_id], references: [id], onDelete: SetNull)
  tercero_id            String
  tercero               Tercero       @relation(fields: [tercero_id], references: [id])
  /// Causación y recaudo son FECHAS DISTINTAS y ambas importan: la primera
  /// manda en renta e IVA, la segunda en el flujo de caja.
  /// DIA PURO: el día que la persona declara. El instante está en created_at.
  fecha_causacion       DateTime  @db.Date
  /// DIA PURO.
  fecha_recaudo         DateTime? @db.Date
  valor_base            Decimal       @db.Decimal(16, 2)
  /// HECHOS del documento, no cálculos: el IVA facturado y lo que el cliente
  /// retuvo según su comprobante. El sistema calcula un sugerido y AVISA si
  /// difiere, pero guarda lo que realmente ocurrió.
  iva_generado          Decimal       @default(0) @db.Decimal(16, 2)
  retefuente_practicada Decimal       @default(0) @db.Decimal(16, 2)
  reteica_practicada    Decimal       @default(0) @db.Decimal(16, 2)
  reteiva_practicada    Decimal       @default(0) @db.Decimal(16, 2)
  /// Lo que el sistema CALCULÓ con los parámetros del año en el momento de
  /// registrar. Null = no se pudo calcular (faltaba el parámetro).
  /// La DISCREPANCIA no se guarda: se deriva de practicada − sugerida. Un
  /// cliente que retiene de más es dinero recuperable, y sin esto no habría
  /// forma de saberlo.
  iva_sugerido          Decimal?      @db.Decimal(16, 2)
  retefuente_sugerida   Decimal?      @db.Decimal(16, 2)
  reteica_sugerida      Decimal?      @db.Decimal(16, 2)
  reteiva_sugerida      Decimal?      @db.Decimal(16, 2)
  /// Por qué difiere, si se investigó (y si se reclamó).
  nota_discrepancia     String?       @db.Text
  // valor_neto_recibido NO existe como columna: se deriva siempre.
  numero_factura        String?
  /// CUFE de la factura electrónica emitida por el sistema DIAN que se use.
  cufe                  String?
  estado                EstadoIngreso @default(CAUSADO)
  /// Municipio donde se causa el ICA de este ingreso.
  municipio_ica         String?
  /// FOTO del CIIU al causar, igual que municipio_ica: si mañana se corrige el
  /// CIIU del tipo de servicio, lo ya declarado no cambia.
  /// ⚠ null o "" aquí NO significa «todas las actividades» (eso solo vale en
  /// TarifaIca): significa NO CALCULABLE y el cálculo de ICA se detiene.
  ciiu                  String?
  /// true = facturamos la comisión TOTAL (las partes ajenas son egreso);
  /// false = cada corredor facturó lo suyo y aquí va solo nuestra parte.
  facturamos_total      Boolean       @default(true)
  notas                 String?       @db.Text
  /// Id del Admin que lo registró. String sin FK, igual que Contacto.created_by.
  registrado_por        String?
  created_at            DateTime      @default(now())
  updated_at            DateTime      @updatedAt

  distribuciones     DistribucionComision[]
  custodiasAplicadas MovimientoCustodia[]

  @@index([fecha_causacion])
  @@index([fecha_recaudo])
  @@index([estado])
  @@index([property_id])
  @@index([tercero_id])
  @@map("ingresos")
}

model Egreso {
  id                       String            @id @default(uuid())
  categoria_id             String
  categoria                CategoriaEgreso   @relation(fields: [categoria_id], references: [id])
  /// NULLABLE a propósito: un peaje o un tanque de gasolina se captura en tres
  /// toques y muchas veces sin tercero identificado. Se completa después.
  tercero_id               String?
  tercero                  Tercero?          @relation(fields: [tercero_id], references: [id], onDelete: SetNull)
  /// DIA PURO: el día del gasto, tecleado. El instante está en created_at.
  fecha                    DateTime @db.Date
  descripcion              String
  valor_base               Decimal           @db.Decimal(16, 2)
  /// IVA PAGADO al proveedor. Se llama así y no «descontable» a propósito: si
  /// no somos responsables de IVA, NO es recuperable, es COSTO. El nombre viejo
  /// habría dicho una cosa y el cálculo otra. Ver costoEgreso().
  iva_pagado               Decimal           @default(0) @db.Decimal(16, 2)
  /// Las que YO le practico al proveedor (y luego declaro y pago).
  retefuente_practicada    Decimal           @default(0) @db.Decimal(16, 2)
  reteica_practicada       Decimal           @default(0) @db.Decimal(16, 2)
  reteiva_practicada       Decimal           @default(0) @db.Decimal(16, 2)
  /// Lo calculado con los parámetros del año al registrar. Aquí la
  /// discrepancia significa que RETUVIMOS MAL nosotros: o se le debe al
  /// proveedor, o se le debe a la DIAN. Ambas hay que verlas.
  iva_sugerido             Decimal?          @db.Decimal(16, 2)
  retefuente_sugerida      Decimal?          @db.Decimal(16, 2)
  reteica_sugerida         Decimal?          @db.Decimal(16, 2)
  reteiva_sugerida         Decimal?          @db.Decimal(16, 2)
  nota_discrepancia        String?           @db.Text
  // valor_pagado NO existe como columna: se deriva.
  /// No todo gasto real es deducible fiscalmente.
  es_deducible             Boolean           @default(true)
  naturaleza               NaturalezaEgreso  @default(DEL_NEGOCIO)
  /// Cliente que devuelve la plata. Solo con naturaleza REEMBOLSABLE.
  reembolsa_tercero_id     String?
  reembolsaTercero         Tercero?          @relation("EgresoReembolsa", fields: [reembolsa_tercero_id], references: [id], onDelete: SetNull)
  estado_reembolso         EstadoReembolso?
  /// DIA PURO.
  fecha_reembolso          DateTime? @db.Date
  /// Rastro de la reclasificación: de qué naturaleza venía, quién y por qué.
  reclasificado_de         NaturalezaEgreso?
  reclasificado_por        String?
  reclasificado_en         DateTime?
  motivo_reclasificacion   String?
  /// Capturado en la calle sin los datos opcionales. YA cuenta en los
  /// reportes: aparece en «Por completar», no se pierde por estar incompleto.
  por_completar            Boolean           @default(false)
  property_id              String?
  property                 Property?         @relation(fields: [property_id], references: [id], onDelete: SetNull)
  /// URL pública heredada. Para recibos NUEVOS no se usa: van a Cloudinary
  /// privado y aquí solo queda el public_id.
  soporte_url              String?
  /// public_id del recibo en Cloudinary, tipo `authenticated`. NO es una URL:
  /// la imagen se sirve por /api/admin/finanzas/recibos/… con sesión, y el
  /// enlace firmado se genera en el momento y caduca. Ley 1581: un recibo
  /// lleva datos de terceros y no puede quedar en una URL pública permanente.
  soporte_public_id        String?
  metodo_pago              String?
  numero_factura_proveedor String?
  registrado_por           String?
  created_at               DateTime          @default(now())
  updated_at               DateTime          @updatedAt

  distribucion DistribucionComision?

  @@index([fecha])
  @@index([naturaleza, estado_reembolso])
  @@index([por_completar])
  @@index([categoria_id])
  @@index([property_id])
  @@index([tercero_id])
  @@map("egresos")
}

/// DINERO QUE ENTRA Y NO ES INGRESO — arras y anticipos.
///
/// Entidad SEPARADA, no una bandera en Ingreso, y es deliberado: con una
/// bandera, la fila sigue viviendo en `ingresos` y cada consulta, suma y
/// reporte tendría que acordarse de excluirla. Un `WHERE` olvidado infla la
/// base gravable y produce un impuesto que no se debe. En tabla aparte, el
/// error es estructuralmente imposible.
///
/// REGLA: aquí solo entra dinero SIN causación. En el momento en que hay
/// causación (se emite factura, se presta el servicio), deja de ser custodia y
/// nace un Ingreso — con su IVA y sus retenciones. Por eso este modelo no
/// tiene campos de IVA: si los necesitara, ya no era custodia.
model MovimientoCustodia {
  id                     String             @id @default(uuid())
  naturaleza             NaturalezaCustodia
  /// arras, depósito de seriedad, anticipo de honorarios…
  concepto               String
  tercero_id             String
  tercero                Tercero            @relation("CustodiaOrigen", fields: [tercero_id], references: [id])
  property_id            String?
  property               Property?          @relation(fields: [property_id], references: [id], onDelete: SetNull)
  /// DIA PURO: el día que la persona declara. La hora era precisión falsa.
  fecha_recibido         DateTime @db.Date
  valor                  Decimal            @db.Decimal(16, 2)
  estado                 EstadoCustodia     @default(RECIBIDO)
  /// DIA PURO.
  fecha_cierre           DateTime? @db.Date
  /// A quién se le entregó, si era dinero de terceros.
  entregado_a_tercero_id String?
  entregadoA             Tercero?           @relation("CustodiaDestino", fields: [entregado_a_tercero_id], references: [id], onDelete: SetNull)
  /// Si terminó reconociéndose como ingreso nuestro (anticipo causado, o arras
  /// retenidas que nos corresponden), apunta al Ingreso que lo reconoce.
  ingreso_id             String?
  ingreso                Ingreso?           @relation(fields: [ingreso_id], references: [id], onDelete: SetNull)
  soporte_url            String?
  notas                  String?            @db.Text
  registrado_por         String?
  created_at             DateTime           @default(now())
  updated_at             DateTime           @updatedAt

  @@index([estado])
  @@index([property_id])
  @@index([tercero_id])
  @@map("movimientos_custodia")
}

/// COMISIÓN COMPARTIDA. Las filas suman SIEMPRE la comisión total de la
/// operación, incluida nuestra parte (rol = PROPIA). Lo que cambia según el
/// escenario es qué se factura:
///   · facturamos_total = true  → Ingreso.valor_base es el TOTAL y cada parte
///     ajena genera un Egreso (con la retención que le practicamos).
///   · facturamos_total = false → Ingreso.valor_base es SOLO nuestra parte y
///     las ajenas son informativas: no tocan la base gravable, pero sí sirven
///     para la rentabilidad real de la operación.
model DistribucionComision {
  id            String           @id @default(uuid())
  ingreso_id    String
  ingreso       Ingreso          @relation(fields: [ingreso_id], references: [id], onDelete: Cascade)
  /// Null cuando la fila es nuestra parte (rol = PROPIA).
  tercero_id    String?
  tercero       Tercero?         @relation(fields: [tercero_id], references: [id], onDelete: SetNull)
  rol           RolParticipacion
  porcentaje    Decimal?         @db.Decimal(5, 2)
  valor         Decimal          @db.Decimal(16, 2)
  /// Si facturamos el total, la parte ajena se paga y es egreso nuestro.
  genera_egreso Boolean          @default(false)
  egreso_id     String?          @unique
  egreso        Egreso?          @relation(fields: [egreso_id], references: [id], onDelete: SetNull)
  notas         String?

  @@index([ingreso_id])
  @@map("distribuciones_comision")
}

/// ENLACE DE SOLO LECTURA PARA EL CONTADOR — ⚠ NO CONSTRUIDO. SOLO ESTA TABLA.
///
/// ⚠⚠ LEE ESTO ANTES DE CREER NADA DE LO QUE SIGUE. Esta tabla existe y está
/// vacía (0 filas, verificado 2026-10-16). De las tres piezas que necesita el
/// enlace, **no hay ninguna**:
///
///   1. Ruta pública que acepte el token           — NO EXISTE
///   2. Verificación token + PIN y sesión con scope — NO EXISTE
///   3. Consulta que ACOTE al periodo de la fila    — NO EXISTE
///
/// Por eso `periodo_desde` y `periodo_hasta` no las llena nadie: no porque se
/// olvidaran, sino porque no hay código que las lea. **Ningún filtro de periodo
/// está implementado en ninguna parte del proyecto.**
///
/// NO CONFUNDIR con `/interno/datos-contador`, que sí existe: ese es el
/// formulario que el contador NOS llena (parámetros fiscales del año, sin
/// escritura al servidor). Va en la dirección contraria y no lee esta tabla.
///
/// CUÁNDO SE CONSTRUYA, el diseño previsto es el de `EnlaceVisitantes` —token de
/// 256 bits, PIN con bcrypt, bloqueo por intentos, sesión JWT con scope propio—
/// más lo único que añade: el alcance por periodo. Y la regla que habrá que
/// cumplir, hoy incumplible porque no hay endpoint: el periodo sale SIEMPRE de
/// esta fila y el endpoint no acepta fechas, así que no hay parámetro que
/// manipular —la misma garantía que el `select` de `visitantesDe()`—.
///
/// REQUISITOS QUE LA POLÍTICA PÚBLICA YA LE IMPONE (2026-10-16). No son una
/// aspiración: están escritos en /politica-tratamiento-datos §4, así que el día
/// que esto se construya tiene que cumplirlos o la política vuelve a mentir.
///
///   a. El extracto SÍ lleva identificación de terceros —nombre o razón social
///      y documento o NIT de clientes y proveedores—, porque sin eso no se
///      elabora una declaración. La política lo dice así a propósito: la
///      redacción anterior prometía lo contrario y habría nacido falsa.
///   b. El extracto NO puede exponer el registro de visitas a inmuebles ni las
///      conversaciones con Mac. Son otra finalidad y la política lo excluye.
///      ⇒ la consulta del enlace no debe tocar `visita` ni `conversation`.
///   c. El contador es ENCARGADO DEL TRATAMIENTO (Ley 1581): finalidad
///      tributaria, reserva, y prohibición de cederlo.
///
/// `scripts/verificar-enlace-contador.mjs` comprueba (b) el día que la ruta
/// exista, porque es el único de los tres que se puede leer en el código.
///
/// Mientras eso no exista, **esto es un esquema, no una promesa cumplida.**
model EnlaceContador {
  id               String                 @id @default(uuid())
  createdAt        DateTime               @default(now())
  /// Para identificarlo en el panel: «Contador — bimestre 5 de 2026».
  etiqueta         String
  token            String                 @unique
  /// bcrypt del PIN. NUNCA en texto plano.
  pinHash          String
  /// Alcance PREVISTO del enlace. ⚠ Hoy no lo lee nadie: no hay consulta que
  /// filtre por este rango, así que la columna no restringe nada todavía.
  /// DIA PURO: el periodo de un reporte es un rango de días, no de instantes.
  periodo_desde    DateTime @db.Date
  /// DIA PURO.
  periodo_hasta    DateTime @db.Date
  expiraAt         DateTime
  revocado         Boolean                @default(false)
  ultimoAcceso     DateTime?
  intentosFallidos Int                    @default(0)
  creado_por       String?
  accesos          AccesoEnlaceContador[]

  @@map("enlaces_contador")
}

/// Bitácora de accesos al enlace del contador. ⚠ VACÍA Y SIN ESCRITOR: no hay
/// ruta que registre un acceso, porque el enlace no existe (ver arriba). El cron
/// de retención SÍ corre cada noche sobre ella y por eso reporta siempre cero:
/// ese cero dice «no hay nada», no «la retención funciona», y el mensaje del
/// cron está obligado a distinguir las dos cosas.
///
/// RETENCIÓN PREVISTA (Ley 1581, minimización): a los 12 meses el cron ANONIMIZA la
/// fila — pone `ip` y `userAgent` en null — y CONSERVA `fecha` y `enlace_id`.
/// Así queda el rastro de que el enlace se usó y cuándo, que es lo que tiene
/// valor de auditoría, sin retener el dato personal más de lo necesario.
model AccesoEnlaceContador {
  id             String         @id @default(uuid())
  enlace_id      String
  enlace         EnlaceContador @relation(fields: [enlace_id], references: [id], onDelete: Cascade)
  fecha          DateTime       @default(now())
  /// Se anonimizan a los 12 meses (quedan en null); la fila NO se borra.
  ip             String?
  userAgent      String?
  /// Marca de que ya fue anonimizada, para no reprocesarla cada noche.
  anonimizado_en DateTime?

  @@index([enlace_id, fecha])
  @@index([anonimizado_en, fecha])
  @@map("accesos_enlace_contador")
}

// ─── CALCULADORA DE GASTOS NOTARIALES ────────────────────────────────────────
//
// Siete tablas. El motor vive en src/lib/notariales y no importa nada de aquí:
// recibe el año como parámetro, así que se prueba entero en memoria. Estos
// modelos son el espejo de esos tipos.
//
// ⚠ NINGUNA TARIFA HABILITA NADA SIN SU RESPALDO. Un año puede tener todas las
// cifras cargadas y seguir sin poder liquidar: lo que habilita el cálculo es la
// fila de RespaldoNormativo, con su URL oficial y su fecha de vigencia.

/// Dominio autorizado para respaldar una cifra. Tabla, no lista en código:
/// añadir una autoridad es una fila, pero es un acto deliberado y queda firmado.
model FuenteNormativa {
  id      String  @id @default(uuid())
  dominio String  @unique
  entidad String
  /// OFICIAL | SECUNDARIA. Solo OFICIAL respalda; SECUNDARIA deja constancia de
  /// que se consultó algo que NO sirve de respaldo.
  tipo    String  @default("OFICIAL")
  activo  Boolean @default(true)
  /// Es una compilación (un normograma), no la entidad emisora. Cuando lo es, el
  /// respaldo que la cite está obligado a llevar `nota`.
  es_compilacion Boolean  @default(false)
  /// Lo que hay que decir siempre que se cite esta fuente.
  advertencia    String?  @db.Text
  agregada_por   String
  agregada_en    DateTime @default(now())

  respaldos RespaldoNormativo[]

  @@map("fuentes_normativas")
}

/// El respaldo de UN campo. Sin él, ese campo no habilita nada.
model RespaldoNormativo {
  id String @id @default(uuid())
  /// ANIO | CONCEPTO | REGLA_RETENCION
  ambito String
  /// id de la fila respaldada, según el ámbito.
  referencia_id String
  /// uvt | uvb | tarifa_iva | redondeo_iva | base_notarial | base_registro |
  /// base_orip | base_timbre | base_retencion | tramos | valor | redondeo |
  /// reparto | sujeto_legal | tarifa
  campo    String
  norma    String
  /// El artículo donde está la CIFRA.
  articulo String?
  /// URL_OFICIAL | DOCUMENTO_ARCHIVADO.
  ///
  /// La URL nunca fue el requisito: era un sustituto de la procedencia, y en la
  /// resolución notarial apunta al revés. La compilación de la Cancillería TIENE
  /// enlace y es PEOR evidencia que el PDF firmado —trae erratas y no es la
  /// entidad emisora—, mientras el documento lleva firma, radicado y sellos.
  /// Lo que se amplía es el SOPORTE, no la autoridad: un PDF de una notaría
  /// particular, de un gremio o de un sitio comercial sigue sin valer.
  tipo_evidencia String @default("URL_OFICIAL")
  /// Obligatoria con URL_OFICIAL. Con un documento archivado puede no existir.
  url      String?
  /// La autoridad, por su fila en fuentes_normativas. Con una URL se deduce del
  /// dominio; un documento no trae dominio, así que hay que nombrarla.
  fuente_dominio String?
  // ── Solo DOCUMENTO_ARCHIVADO: la guarda exige las seis ──
  /// Dónde quedó guardado, para poder volver a abrirlo.
  documento_ruta  String?
  /// SHA-256 en hexadecimal: sin él, sustituir el archivo no deja rastro.
  documento_hash  String?
  /// La entidad que lo emitió, como la nombra el propio documento.
  entidad_emisora String?
  /// De dónde se obtuvo, en texto, y cuándo.
  obtenido_de     String?   @db.Text
  obtenido_en     DateTime? @db.Date
  archivado_por   String?
  /// DÓNDE LO CONSIGUE EL LECTOR por su cuenta. Obligatorio con un documento
  /// archivado: el PDF se guarda como `authenticated` y NO se publica —publicar
  /// una copia de una norma que no emitimos nos convertiría en un sitio desde el
  /// que citarla, y cuando la entidad la modifique nuestra copia diría lo viejo
  /// con nuestra marca encima—. Sin esta frase, la simulación citaría un
  /// documento que nadie más puede ver.
  donde_conseguirlo String? @db.Text

  fuente_id String?
  fuente    FuenteNormativa? @relation(fields: [fuente_id], references: [id])

  fecha_norma DateTime? @db.Date
  /// ¿La norma lo EXIGE, o lo PERMITE y lo adoptamos nosotros? El Concepto DIAN
  /// 003550 dice «podrá aproximarse»: el redondeo del IVA es ADOPTADO, no
  /// exigido, y el respaldo no puede afirmar lo contrario.
  caracter    String    @default("EXIGIDO")
  /// DESDE CUÁNDO RIGE. Obligatoria: el año es una etiqueta, no un rango. La
  /// notarial de 2026 rige desde el 1 de febrero y la registral desde el 2.
  vigencia_desde DateTime  @db.Date
  /// Hasta cuándo rigió. NULL = sigue vigente.
  vigencia_hasta DateTime? @db.Date
  /// El artículo que fija la VIGENCIA, que no es el de la cifra: la tarifa está
  /// en el art. 50 y la vigencia en el art. 56. Y puede estar modificado por otra
  /// resolución que ese artículo no menciona.
  articulo_vigencia String?
  /// Obligatoria cuando la fuente es una compilación.
  nota              String?  @db.Text
  verificado_por    String
  verificado_en     DateTime @default(now())

  @@unique([ambito, referencia_id, campo])
  @@index([vigencia_desde])
  @@map("respaldos_normativos")
}

/// Un año tarifario. `anio` es una ETIQUETA, no un rango de fechas.
model AnioNotarial {
  id   String @id @default(uuid())
  anio Int    @unique
  /// BORRADOR | ACTIVO. Misma semántica que parametros_fiscales.
  estado     String   @default("BORRADOR")
  uvt        Decimal? @db.Decimal(14, 2)
  uvb        Decimal? @db.Decimal(14, 2)
  tarifa_iva Decimal? @db.Decimal(5, 2)
  /// A qué múltiplo aproxima el IVA y en qué sentido. Es regla normativa, no
  /// decisión del motor: sin respaldo cargado, el IVA no liquida.
  redondeo_iva_unidad Int?
  /// CERCANO | ARRIBA | ABAJO | PUBLICADO
  redondeo_iva_modo   String?
  /// Sube con CUALQUIER escritura sobre el año, sus conceptos, sus tramos o sus
  /// reglas, y en la MISMA transacción: alimenta el código del PDF, y si subiera
  /// aparte, dos PDF con tarifas distintas podrían llevar el mismo código.
  version                Int      @default(1)
  version_actualizada_en DateTime @default(now())
  cerrado                Boolean  @default(false)
  notas                  String?  @db.Text
  activado_por           String?
  activado_en            DateTime?
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt

  conceptos ConceptoNotarial[]
  reglas    ReglaRetencionNotarial[]

  @@map("anios_notariales")
}

/// Un concepto de la liquidación. Tabla y no enum: añadir un concepto no puede
/// exigir una migración.
model ConceptoNotarial {
  id      String       @id @default(uuid())
  anio_id String
  anio    AnioNotarial @relation(fields: [anio_id], references: [id], onDelete: Cascade)
  clave   String
  label   String
  /// Para el texto de la página. «beneficencia» entra aquí; NUNCA es el nombre
  /// del concepto, que es «impuesto de registro».
  terminos_coloquiales String[] @default([])
  /// COSTOS_NOTARIALES | IMPUESTOS | REGISTRO | DOCUMENTOS_PREVIOS | OBLIGACIONES
  grupo String
  orden Int
  /// FIJO | PORCENTAJE | POR_MIL | TRAMOS | POR_UNIDAD | VALOR_LIBRE | REGLAS
  tipo  String
  /// NOTARIAL | REGISTRO | ORIP | TIMBRE | RETENCION | TARIFA_REGISTRAL |
  /// UNIDADES | NINGUNA. Cada valor nombra UNA función con su propia norma: la
  /// notarial toma el mayor de cuatro valores (art. 51 a) y la registral de dos.
  base  String

  valor  Decimal? @db.Decimal(14, 2)
  /// PESOS | PORCENTAJE | POR_MIL. Sin esto, un 3 que significa «3 por mil»
  /// leído como «3 %» es un error de diez veces que da una cifra plausible.
  unidad String?

  redondeo_unidad Int?
  /// CERCANO | ARRIBA | ABAJO | PUBLICADO. PUBLICADO = la cifra se toma tal cual
  /// la trae la resolución y el motor no la recalcula.
  redondeo_modo   String?
  /// NO_DECRECIENTE | LIBRE. Propiedad del concepto, no creencia sobre el mundo:
  /// una tabla normativa futura puede bajar.
  monotonicidad   String  @default("LIBRE")

  grava_iva Boolean @default(false)
  /// El precio publicado YA lleva el IVA dentro (copia simple, art. 5). El
  /// componente se extrae; jamás se suma un 19 % encima, y no vuelve a BASE_IVA.
  precio_incluye_iva  Boolean @default(false)
  /// Lo cobra la notaría pero no es su remuneración: sale de la base del IVA.
  es_recaudo_terceros Boolean @default(false)

  /// VENDEDOR | COMPRADOR | AMBAS_PARTES | CONTRATANTES. El obligado ante la
  /// autoridad, que NO es quién lo paga en el negocio.
  sujeto_legal        String
  /// % que asume el comprador por defecto.
  reparto_por_defecto Decimal @db.Decimal(5, 2)
  reparto_editable    Boolean @default(true)
  /// NORMA_SUPLETIVA | COSTUMBRE | CONTRIBUYENTE | CONFIGURACION.
  /// NORMA_SUPLETIVA exige `norma_reparto`; CONFIGURACION lo PROHÍBE —imprimirla
  /// afirmaría que la ley reparte así—; CONTRIBUYENTE impide editar el reparto,
  /// porque no hay reparto que repartir: hay un obligado.
  motivo_reparto      String
  norma_reparto       String?

  solo_avanzada             Boolean @default(false)
  opcional                  Boolean @default(false)
  activo_por_defecto        Boolean @default(true)
  aplica_en_sencilla        Boolean @default(false)
  es_estimacion_en_sencilla Boolean @default(false)
  /// HACIA DÓNDE desvía el supuesto, escrito. Obligatorio en todo concepto
  /// marcado como estimación: «Si la notaría expide más, el costo sube». Sin la
  /// dirección, el aviso informa de que hay incertidumbre y no de qué hacer.
  sesgo_en_sencilla String? @db.Text

  /// La unidad de la TARIFA, con su plural ESCRITO: «copia auténtica» no
  /// pluraliza añadiendo una «s», y esto lo lee un comprador junto a una cifra.
  unidad_label  String?
  unidad_plural String?
  /// CANTIDAD DERIVADA: clave de otro concepto cuya cantidad se multiplica por la
  /// de este. Las hojas de la escritura se preguntan UNA vez y alimentan el papel
  /// notarial y las copias auténticas; preguntarlas dos veces las desincronizaría
  /// sin un solo error.
  multiplica_cantidad_de String?
  /// CLAVE AJENA COMPUESTA sobre (anio_id, clave): hace imposible —no
  /// improbable— que apunte a un concepto que no existe, incluso si alguien
  /// escribe directo en la base. Comprobado contra Postgres antes de aplicarla:
  /// con la columna en NULL no exige nada (MATCH SIMPLE); una clave inexistente
  /// o de OTRO año se rechaza; borrar el origen mientras algo lo deriva se
  /// rechaza; y borrar el año entero funciona, porque NO ACTION se comprueba al
  /// final de la sentencia.
  ///
  /// ⚠ EXIGE ORDEN DE INSERCIÓN: el origen antes que el derivado. Lo garantiza
  /// `exigirOrdenDeDerivados`, que corre en las pruebas: si alguien reordena el
  /// catálogo, falla el arnés y no la siembra.
  origen_cantidad ConceptoNotarial?  @relation("CantidadDerivada", fields: [anio_id, multiplica_cantidad_de], references: [anio_id, clave], onDelete: NoAction, onUpdate: NoAction)
  derivados       ConceptoNotarial[] @relation("CantidadDerivada")
  /// Qué cuenta el usuario cuando la cantidad es derivada: «3 copias», no «24
  /// hojas». Obligatorio si `multiplica_cantidad_de`.
  unidad_captura_label   String?
  unidad_captura_plural  String?
  /// Supuesto DECLARADO de la calculadora sencilla, que no pregunta la cantidad.
  /// Exige `es_estimacion_en_sencilla`: un supuesto que no se declara no se ve.
  cantidad_en_sencilla   Int?
  cantidad_sugerida      Int?
  /// El VALOR cambia según la notaría.
  cantidad_variable_por_notaria   Boolean @default(false)
  /// La CANTIDAD depende de la operación.
  cantidad_variable_por_operacion Boolean @default(false)
  /// Texto de la pregunta: cuándo aplica este concepto y cuándo no.
  ayuda      String?  @db.Text
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tramos TramoConcepto[]

  @@unique([anio_id, clave])
  @@index([anio_id, orden])
  @@map("conceptos_notariales")
}

/// Un tramo de una tabla por cuantía. Un solo mecanismo cubre el mínimo
/// notarial, los tramos ORIP y los marginales del timbre.
model TramoConcepto {
  id          String           @id @default(uuid())
  concepto_id String
  concepto    ConceptoNotarial @relation(fields: [concepto_id], references: [id], onDelete: Cascade)
  orden       Int
  /// LÍMITES CONTIGUOS: el intervalo es `desde < base <= hasta`, porque la
  /// resolución escribe «De $0 hasta $100.000.000» y «hasta» INCLUYE. El «+1»
  /// impreso NO se guarda: dejaría fuera $100.000.000,50, que es una cuantía
  /// posible en cuanto la base sale de un avalúo catastral.
  desde Decimal  @db.Decimal(18, 2)
  /// NULL = tramo abierto. Exactamente uno por concepto.
  hasta Decimal? @db.Decimal(18, 2)
  /// Los límites van en UVT, no en pesos (timbre).
  en_uvt Boolean @default(false)
  /// FIJO | TASA_SOBRE_TOTAL | TASA_MARGINAL
  modo_calculo String
  valor        Decimal @db.Decimal(14, 4)
  /// PESOS | PORCENTAJE | POR_MIL
  unidad       String
  /// DISTRIBUCIÓN INSTITUCIONAL del recaudo (art. 50 parágrafo: 50 % para la
  /// Superintendencia y 50 % para el Fondo). No tiene nada que ver con el reparto
  /// comprador/vendedor: el usuario paga UN recaudo y esto solo sale en el PDF.
  /// Una guarda comprueba que los dos sumen `valor`.
  aporte_snr   Decimal? @db.Decimal(14, 2)
  aporte_fondo Decimal? @db.Decimal(14, 2)
  /// Solo TRAZABILIDAD: la equivalencia en UVB que publica la resolución. El
  /// motor NO recalcula el valor a partir de ella — manda el documento.
  valor_en_uvb Decimal? @db.Decimal(14, 4)

  @@unique([concepto_id, orden])
  @@map("tramos_concepto")
}

/// Motor de excepciones de la retención. Hoy tiene una sola fila —la general— y
/// añadir la siguiente es una fila, SI se apoya en un dato que el formulario ya
/// pregunta. Si necesita una pregunta nueva, eso es código.
model ReglaRetencionNotarial {
  id      String       @id @default(uuid())
  anio_id String
  anio    AnioNotarial @relation(fields: [anio_id], references: [id], onDelete: Cascade)
  clave   String
  label   String
  /// La general va SIEMPRE última, o una excepción nunca se evaluaría.
  orden   Int
  activa  Boolean @default(true)
  /// TARIFA | EXENCION | REDUCCION_PCT_POR_ANIO | TOPE
  tipo_efecto  String
  valor_efecto Decimal? @db.Decimal(14, 4)
  /// PORCENTAJE | POR_MIL
  unidad       String?
  created_at   DateTime @default(now())

  condiciones CondicionReglaRetencion[]

  @@unique([anio_id, clave])
  @@map("reglas_retencion_notarial")
}

/// Condición de una regla. El VALOR se valida contra el tipo del campo: un
/// «juridica» en minúscula dejaba la exención muerta sin un solo error, porque
/// no coincidir no es un error — el motor seguía a la regla siguiente.
model CondicionReglaRetencion {
  id       String                 @id @default(uuid())
  regla_id String
  regla    ReglaRetencionNotarial @relation(fields: [regla_id], references: [id], onDelete: Cascade)
  /// Texto validado contra la lista blanca del módulo hoja, no enum: añadir un
  /// campo no puede exigir una migración.
  campo    String
  /// IGUAL | DISTINTO | MENOR | MENOR_IGUAL | MAYOR | MAYOR_IGUAL | EN
  operador String
  valor    String

  @@map("condiciones_regla_retencion")
}
