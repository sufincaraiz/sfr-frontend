generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Geographic hierarchy ────────────────────────────────────────────────────

model Municipality {
  id           String     @id @default(uuid())
  slug         String     @unique
  name         String
  province     String     @default("Cundinamarca") // departamento
  demand_score Int        @default(0)
  // ── Contenido editable desde el admin (migrado desde municipios-data.ts) ──
  provincia           String?  @default("Gualivá") // subregión/provincia
  distancia_bogota_km Int?
  tiempo_bogota_min   Int?
  altitud_msnm        Int?
  temp_min            Int?
  temp_max            Int?
  descripcion_seo     String?  @db.Text
  meta_description    String?  @db.Text // meta description SEO (~150 car.); vacío = autogenerada
  historia            String?  @db.Text
  clima               String?  @db.Text
  turismo             String?  @db.Text
  inversion           String?  @db.Text
  og_image            String?  // imagen del hero
  geo_lat             Float?
  geo_lng             Float?
  wikipedia_url       String?
  faqs                Json?    // [{ question, answer }]
  tour360_url         String?  // enlace del recorrido 360 del parque principal (Panoee)
  oculto              Boolean  @default(false)
  updated_at          DateTime @default(now()) @updatedAt
  veredas      Vereda[]
  properties   Property[]

  @@map("municipalities")
}

model Vereda {
  id              String       @id @default(uuid())
  slug            String
  name            String
  municipality_id String
  lat             Float?
  lng             Float?
  municipality    Municipality @relation(fields: [municipality_id], references: [id])
  properties      Property[]

  @@unique([slug, municipality_id])
  @@map("veredas")
}

// ─── Core ────────────────────────────────────────────────────────────────────

model Property {
  id               String          @id @default(uuid())
  slug             String          @unique
  type             String          // finca | lote | casa | apartamento | condominio | local
  transaction_type String          @default("venta")
  municipality_id  String
  vereda_id        String?
  address_visible  String?
  price_cop        BigInt
  area_lot_m2      Float?
  area_built_m2    Float?
  bedrooms         Int             @default(0)
  bathrooms        Int             @default(0)
  parking          Int             @default(0)
  year_built       Int?
  status           String          @default("available") // available | reserved | sold
  geo_lat          Float?
  geo_lng          Float?
  published_at     DateTime        @default(now())
  updated_at       DateTime        @updatedAt
  // SEO / content
  title            String?
  short_description String?
  description      String?
  meta_title       String?
  meta_description String?
  // Media embeds
  video_url        String?
  virtual_tour_url String?
  modelo3d_url     String?   // URL a un modelo 3D .glb (fotogrametría con dron)
  // Relations
  municipality     Municipality    @relation(fields: [municipality_id], references: [id])
  vereda           Vereda?         @relation(fields: [vereda_id], references: [id])
  media            PropertyMedia[]
  features         PropertyFeature[]
  leads            Lead[]

  @@index([municipality_id, status, price_cop])
  @@index([vereda_id, status])
  @@index([type, status])
  @@map("properties")
}

/// Catálogo editable de tipos de inmueble. `slug` es exactamente el string que
/// se guarda en `Property.type`, así que la tabla es puramente descriptiva: no
/// hay FK y los datos existentes siguen funcionando sin tocarse. Sirve para
/// alimentar los selectores (admin y filtros públicos), poner etiquetas bonitas
/// y permitir que el admin agregue un tipo nuevo desde el formulario ("Otro…").
model TipoPropiedad {
  id         String   @id @default(uuid())
  slug       String   @unique // valor guardado en Property.type (ej. "lote-campestre")
  label      String // singular, para fichas y chips ("Lote campestre")
  plural     String? // para títulos y headings ("Lotes campestres"); vacío = label + "s"
  orden      Int      @default(100)
  oculto     Boolean  @default(false) // fuera de los selectores, sin borrar el histórico
  updated_at DateTime @default(now()) @updatedAt

  @@map("property_types")
}

model PropertyFeature {
  id            String   @id @default(uuid())
  property_id   String
  feature_key   String
  feature_value String
  property      Property @relation(fields: [property_id], references: [id], onDelete: Cascade)

  @@map("property_features")
}

model PropertyMedia {
  id                String   @id @default(uuid())
  property_id       String
  type              String   // image | video | tour360
  tour360_type      String?  // self_hosted | embed
  tour360_embed_url String?
  url               String
  order             Int      @default(0)
  alt_text          String   @default("")
  is_primary        Boolean  @default(false)
  property          Property @relation(fields: [property_id], references: [id], onDelete: Cascade)

  @@map("property_media")
}

// ─── Agents ─────────────────────────────────────────────────────────────────

model Agent {
  id      String  @id @default(uuid())
  name    String
  slug    String  @unique
  photo   String?
  license String?
  whatsapp String
  email   String  @unique
  leads   Lead[]

  @@map("agents")
}

// ─── Leads ──────────────────────────────────────────────────────────────────

enum LeadQualification {
  SIN_CALIFICAR
  CALIENTE
  TIBIO
  FRIO
  VACIO
  DESCARTADO
}

enum LeadPipeline {
  NUEVO
  CONTACTADO
  VISITA_AGENDADA
  EN_NEGOCIACION
  CERRADO_GANADO
  CERRADO_PERDIDO
}

model Lead {
  id                String            @id @default(uuid())
  property_id       String?
  name              String
  phone             String
  email             String
  channel           String            @default("web")
  message           String?
  utm_source        String?
  utm_medium        String?
  utm_campaign      String?
  created_at        DateTime          @default(now())
  status            String            @default("new")
  assigned_agent_id String?
  // Mac agent fields
  qualification     LeadQualification @default(SIN_CALIFICAR)
  budgetMin         Int?
  budgetMax         Int?
  interestType      String?
  interestZone      String?
  timeframe         String?
  financing         String?
  agentNotes        String?           @db.Text
  source            String?
  portalAdId        String?
  pipeline          LeadPipeline      @default(NUEVO)
  nextAction        String?
  nextActionDate    DateTime?
  lastContactAt     DateTime?
  consentAt         DateTime?         // Ley 1581/2012: 1ª vez que se capta un dato de contacto
  summary           String?           @db.Text  // Resumen de la conversación para el asesor (se genera una vez, al captar el lead)
  summaryAt         DateTime?         // Cuándo se generó el resumen
  property          Property?         @relation(fields: [property_id], references: [id], onDelete: SetNull)
  agent             Agent?            @relation(fields: [assigned_agent_id], references: [id])
  conversations     Conversation[]
  contacto          Contacto?

  @@map("leads")
}

// ─── CRM: contactos con embudo de ventas ─────────────────────────────────────
model Contacto {
  id                  String    @id @default(uuid())
  nombre              String
  telefono            String?
  email               String?
  tipo                String    @default("comprador") // comprador | vendedor | arrendatario
  interes             String?   @db.Text              // qué busca
  etapa               String    @default("nuevo")     // nuevo | contactado | en_seguimiento | cerrado
  proximo_seguimiento DateTime?
  origen              String    @default("manual")    // manual | lead-web | referido | otro
  notas               String?   @db.Text
  lead_id             String?   @unique               // si vino de un Lead web (evita doble conversión)
  lead                Lead?     @relation(fields: [lead_id], references: [id], onDelete: SetNull)
  created_by          String?   // id del usuario (Admin) que lo cargó — conserva historial
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  @@index([etapa])
  @@index([proximo_seguimiento])
  @@map("contactos")
}

// ─── Agent conversations ─────────────────────────────────────────────────────

enum Channel {
  WEB
  WHATSAPP
  TELEGRAM
  APP
}

enum ConvStatus {
  ACTIVE
  ESCALATED
  CLOSED
}

enum MsgRole {
  USER
  ASSISTANT
}

model Conversation {
  id          String     @id @default(cuid())
  channel     Channel    @default(WEB)
  externalId  String
  leadId      String?
  lead        Lead?      @relation(fields: [leadId], references: [id])
  status      ConvStatus @default(ACTIVE)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  // Contabilidad de tokens y topes de consumo (agente Mac)
  tokensIn     Int       @default(0)
  tokensOut    Int       @default(0)
  turnCount    Int       @default(0)
  offTopicCount Int      @default(0)
  closedAt     DateTime?
  closedReason String?
  // 1ª (y única) escalación al asesor humano: evita notificaciones ilimitadas por sesión.
  escalatedAt  DateTime?
  // Escalamiento al modelo experto (Opus). Se contabilizan APARTE de los tokens de
  // Haiku porque el costo por token es muy distinto y hay que verlos por separado.
  expertCallCount Int    @default(0)
  expertTokensIn  Int    @default(0)
  expertTokensOut Int    @default(0)
  messages    Message[]

  @@unique([channel, externalId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  role           MsgRole
  content        String       @db.Text
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@map("messages")
}

/// Base de conocimiento de Mac: fichas de información que se inyectan en su
/// prompt en cada conversación (promociones, formas de pago, FAQ, políticas).
/// Se administra en /admin/mac — no requiere desplegar para actualizarse.
model MacKnowledge {
  id         String   @id @default(uuid())
  titulo     String
  contenido  String   @db.Text
  categoria  String   @default("General")
  activo     Boolean  @default(true)
  orden      Int      @default(0)
  vigente_hasta DateTime?  // opcional: se ignora automáticamente al vencer (promos)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([activo, orden])
  @@map("mac_knowledge")
}

// ─── Admin ──────────────────────────────────────────────────────────────────

model Admin {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  nombre    String
  role      String   @default("admin") // admin | asistente_crm | autor_blog
  activo    Boolean  @default(true)    // desactivar (no borrar) para conservar historial
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  articulos Article[]

  @@map("admins")
}

// ─── Content ────────────────────────────────────────────────────────────────

model Article {
  id               String   @id @default(uuid())
  slug             String   @unique
  title            String
  excerpt          String?
  content          String   @db.Text
  cover_image_url  String?
  published_at     DateTime?
  updated_at       DateTime @updatedAt
  meta_title       String?
  meta_description String?
  // Aportes de la comunidad (blog colaborativo)
  author_name      String?
  author_photo_url String?
  author_email     String?
  // Autor con cuenta propia (rol autor_blog). null = artículo MDX/comunidad/legacy.
  author_id        String?
  autor            Admin?   @relation(fields: [author_id], references: [id], onDelete: SetNull)
  created_at       DateTime @default(now())

  @@index([author_id])
  @@map("articles")
}

/// Registro de visitas a inmuebles (control de ingreso y seguridad).
/// Contiene datos personales sensibles (cédula), así que cada fila guarda la
/// PRUEBA del consentimiento: el momento exacto y las dos autorizaciones por
/// separado, como exige la Ley 1581 de 2012 (Habeas Data).
model Visita {
  id                    String   @id @default(uuid())
  createdAt             DateTime @default(now())
  nombresCompletos      String
  cedula                String
  inmuebleReferencia    String // texto libre: referencia o nombre que escribe el visitante
  correo                String
  celular               String
  municipioOrigen       String
  // ── Prueba del consentimiento ──
  consentAt             DateTime // cuándo aceptó
  consentPolitica       Boolean  @default(false) // casilla 1: política de tratamiento
  consentControlIngreso Boolean  @default(false) // casilla 2: control de ingreso y seguridad
  ip                    String? // trazabilidad de seguridad; puede faltar

  @@index([createdAt])
  @@index([cedula])
  @@map("visitas")
}

model Business {
  id              String   @id @default(uuid())
  nombre          String
  imagen_url      String?  // legacy: portada única (respaldo). Ahora se usa `imagenes`.
  imagenes        String[] @default([]) // hasta 5 fotos; imagenes[0] = portada
  descripcion     String?  // descripción corta
  categoria       String   // Restaurante | Ferretería | Droguería | Vivero | Otros
  municipio       String   @default("La Vega")
  whatsapp        String?
  domicilios      Boolean  @default(false)
  google_maps_url String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@index([categoria])
  @@index([municipio])
  @@map("businesses")
}

model PageContent {
  id         String   @id @default(uuid())
  key        String   @unique
  data       Json
  updated_at DateTime @updatedAt

  @@map("page_content")
}

model Redirect {
  id          String @id @default(uuid())
  source      String @unique
  destination String
  permanent   Boolean @default(true)

  @@map("redirects")
}

model SearchLog {
  id          String   @id @default(uuid())
  query       String?
  tipo        String?
  municipio   String?
  precio_max  BigInt?
  results     Int      @default(0)
  created_at  DateTime @default(now())

  @@map("search_logs")
}
