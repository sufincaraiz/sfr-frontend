generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Geographic hierarchy ────────────────────────────────────────────────────

model Municipality {
  id           String     @id @default(uuid())
  slug         String     @unique
  name         String
  province     String     @default("Cundinamarca") // departamento
  demand_score Int        @default(0)
  // ── Contenido editable desde el admin (migrado desde municipios-data.ts) ──
  provincia           String?  @default("Gualivá") // subregión/provincia
  distancia_bogota_km Int?
  tiempo_bogota_min   Int?
  altitud_msnm        Int?
  temp_min            Int?
  temp_max            Int?
  descripcion_seo     String?  @db.Text
  meta_description    String?  @db.Text // meta description SEO (~150 car.); vacío = autogenerada
  historia            String?  @db.Text
  clima               String?  @db.Text
  turismo             String?  @db.Text
  /// Qué revisar ANTES de comprar aquí: acceso, agua, uso del suelo, qué tipo
  /// de inmueble se consigue. Sustituye a `inversion`, que preguntaba «por qué
  /// invertir aquí» y por tanto presuponía la respuesta — la novena forma de
  /// esconderse, en el nombre de la columna. Sin precios, sin horizontes, sin
  /// comparaciones entre municipios.
  antes_de_comprar    String?  @db.Text
  og_image            String?  // imagen del hero
  geo_lat             Float?
  geo_lng             Float?
  wikipedia_url       String?
  faqs                Json?    // [{ question, answer }]
  tour360_url         String?  // enlace del recorrido 360 del parque principal (Panoee)
  oculto              Boolean  @default(false)
  updated_at          DateTime @default(now()) @updatedAt
  veredas      Vereda[]
  properties   Property[]

  @@map("municipalities")
}

model Vereda {
  id              String       @id @default(uuid())
  slug            String
  name            String
  municipality_id String
  lat             Float?
  lng             Float?
  municipality    Municipality @relation(fields: [municipality_id], references: [id])
  properties      Property[]

  @@unique([slug, municipality_id])
  @@map("veredas")
}

// ─── Core ────────────────────────────────────────────────────────────────────

model Property {
  id               String          @id @default(uuid())
  slug             String          @unique
  /// Tipo FÍSICO del inmueble. «condominio» ya no es un tipo: era el régimen
  /// de propiedad colándose en el campo que describe qué es el bien, y por eso
  /// un lote y una casa dentro del mismo condominio caían en la misma bolsa.
  /// El régimen vive ahora en `en_condominio`.
  type             String          // finca | lote | casa | apartamento | local
  /// Régimen de propiedad horizontal: el inmueble está dentro de un condominio
  /// o conjunto cerrado. Es ORTOGONAL al tipo — hay lotes en condominio y casas
  /// en condominio, y son búsquedas distintas.
  en_condominio    Boolean         @default(false)
  transaction_type String          @default("venta")
  municipality_id  String
  vereda_id        String?
  address_visible  String?
  price_cop        BigInt
  area_lot_m2      Float?
  area_built_m2    Float?
  bedrooms         Int             @default(0)
  bathrooms        Int             @default(0)
  parking          Int             @default(0)
  year_built       Int?
  status           String          @default("available") // available | reserved | sold
  geo_lat          Float?
  geo_lng          Float?
  published_at     DateTime        @default(now())
  updated_at       DateTime        @updatedAt
  // SEO / content
  title            String?
  short_description String?
  description      String?
  meta_title       String?
  meta_description String?
  // Media embeds
  video_url        String?
  virtual_tour_url String?
  modelo3d_url     String?   // URL a un modelo 3D .glb (fotogrametría con dron)
  // Relations
  municipality     Municipality    @relation(fields: [municipality_id], references: [id])
  vereda           Vereda?         @relation(fields: [vereda_id], references: [id])
  media            PropertyMedia[]
  features         PropertyFeature[]
  leads            Lead[]
  visitas          Visita[]
  enlacesVisitantes EnlaceVisitantes[]
  ingresos          Ingreso[]
  egresos           Egreso[]
  custodias         MovimientoCustodia[]

  @@index([municipality_id, status, price_cop])
  @@index([vereda_id, status])
  @@index([type, status])
  @@map("properties")
}

/// Catálogo editable de tipos de inmueble. `slug` es exactamente el string que
/// se guarda en `Property.type`, así que la tabla es puramente descriptiva: no
/// hay FK y los datos existentes siguen funcionando sin tocarse. Sirve para
/// alimentar los selectores (admin y filtros públicos), poner etiquetas bonitas
/// y permitir que el admin agregue un tipo nuevo desde el formulario ("Otro…").
model TipoPropiedad {
  id         String   @id @default(uuid())
  slug       String   @unique // valor guardado en Property.type (ej. "lote-campestre")
  label      String // singular, para fichas y chips ("Lote campestre")
  plural     String? // para títulos y headings ("Lotes campestres"); vacío = label + "s"
  orden      Int      @default(100)
  oculto     Boolean  @default(false) // fuera de los selectores, sin borrar el histórico
  updated_at DateTime @default(now()) @updatedAt

  @@map("property_types")
}

model PropertyFeature {
  id            String   @id @default(uuid())
  property_id   String
  feature_key   String
  feature_value String
  property      Property @relation(fields: [property_id], references: [id], onDelete: Cascade)

  @@map("property_features")
}

model PropertyMedia {
  id                String   @id @default(uuid())
  property_id       String
  type              String   // image | video | tour360
  tour360_type      String?  // self_hosted | embed
  tour360_embed_url String?
  url               String
  order             Int      @default(0)
  alt_text          String   @default("")
  is_primary        Boolean  @default(false)
  property          Property @relation(fields: [property_id], references: [id], onDelete: Cascade)

  @@map("property_media")
}

// ─── Agents ─────────────────────────────────────────────────────────────────

model Agent {
  id      String  @id @default(uuid())
  name    String
  slug    String  @unique
  photo   String?
  license String?
  whatsapp String
  email   String  @unique
  leads   Lead[]

  @@map("agents")
}

// ─── Leads ──────────────────────────────────────────────────────────────────

enum LeadQualification {
  SIN_CALIFICAR
  CALIENTE
  TIBIO
  FRIO
  VACIO
  DESCARTADO
}

enum LeadPipeline {
  NUEVO
  CONTACTADO
  VISITA_AGENDADA
  EN_NEGOCIACION
  CERRADO_GANADO
  CERRADO_PERDIDO
}

model Lead {
  id                String            @id @default(uuid())
  property_id       String?
  name              String
  phone             String
  email             String
  channel           String            @default("web")
  message           String?
  utm_source        String?
  utm_medium        String?
  utm_campaign      String?
  created_at        DateTime          @default(now())
  status            String            @default("new")
  assigned_agent_id String?
  // Mac agent fields
  qualification     LeadQualification @default(SIN_CALIFICAR)
  budgetMin         Int?
  budgetMax         Int?
  interestType      String?
  interestZone      String?
  timeframe         String?
  financing         String?
  agentNotes        String?           @db.Text
  source            String?
  portalAdId        String?
  pipeline          LeadPipeline      @default(NUEVO)
  nextAction        String?
  nextActionDate    DateTime?
  lastContactAt     DateTime?
  consentAt         DateTime?         // Ley 1581/2012: 1ª vez que se capta un dato de contacto
  summary           String?           @db.Text  // Resumen de la conversación para el asesor (se genera una vez, al captar el lead)
  summaryAt         DateTime?         // Cuándo se generó el resumen
  property          Property?         @relation(fields: [property_id], references: [id], onDelete: SetNull)
  agent             Agent?            @relation(fields: [assigned_agent_id], references: [id])
  conversations     Conversation[]
  contacto          Contacto?

  @@map("leads")
}

// ─── CRM: contactos con embudo de ventas ─────────────────────────────────────
model Contacto {
  id                  String    @id @default(uuid())
  nombre              String
  telefono            String?
  email               String?
  tipo                String    @default("comprador") // comprador | vendedor | arrendatario
  interes             String?   @db.Text              // qué busca
  etapa               String    @default("nuevo")     // nuevo | contactado | en_seguimiento | cerrado
  proximo_seguimiento DateTime?
  origen              String    @default("manual")    // manual | lead-web | referido | otro
  notas               String?   @db.Text
  lead_id             String?   @unique               // si vino de un Lead web (evita doble conversión)
  lead                Lead?     @relation(fields: [lead_id], references: [id], onDelete: SetNull)
  created_by          String?   // id del usuario (Admin) que lo cargó — conserva historial
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  tercero             Tercero?

  @@index([etapa])
  @@index([proximo_seguimiento])
  @@map("contactos")
}

// ─── Agent conversations ─────────────────────────────────────────────────────

enum Channel {
  WEB
  WHATSAPP
  TELEGRAM
  APP
}

enum ConvStatus {
  ACTIVE
  ESCALATED
  CLOSED
}

enum MsgRole {
  USER
  ASSISTANT
}

model Conversation {
  id          String     @id @default(cuid())
  channel     Channel    @default(WEB)
  externalId  String
  leadId      String?
  lead        Lead?      @relation(fields: [leadId], references: [id])
  status      ConvStatus @default(ACTIVE)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  // Contabilidad de tokens y topes de consumo (agente Mac)
  tokensIn     Int       @default(0)
  tokensOut    Int       @default(0)
  turnCount    Int       @default(0)
  offTopicCount Int      @default(0)
  closedAt     DateTime?
  closedReason String?
  // 1ª (y única) escalación al asesor humano: evita notificaciones ilimitadas por sesión.
  escalatedAt  DateTime?
  // Escalamiento al modelo experto (Opus). Se contabilizan APARTE de los tokens de
  // Haiku porque el costo por token es muy distinto y hay que verlos por separado.
  expertCallCount Int    @default(0)
  expertTokensIn  Int    @default(0)
  expertTokensOut Int    @default(0)
  messages    Message[]

  @@unique([channel, externalId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  role           MsgRole
  content        String       @db.Text
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@map("messages")
}

/// Base de conocimiento de Mac: fichas de información que se inyectan en su
/// prompt en cada conversación (promociones, formas de pago, FAQ, políticas).
/// Se administra en /admin/mac — no requiere desplegar para actualizarse.
model MacKnowledge {
  id         String   @id @default(uuid())
  titulo     String
  contenido  String   @db.Text
  categoria  String   @default("General")
  activo     Boolean  @default(true)
  orden      Int      @default(0)
  vigente_hasta DateTime?  // opcional: se ignora automáticamente al vencer (promos)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([activo, orden])
  @@map("mac_knowledge")
}

// ─── Admin ──────────────────────────────────────────────────────────────────

model Admin {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  nombre    String
  role      String   @default("admin") // admin | asistente_crm | autor_blog
  activo    Boolean  @default(true)    // desactivar (no borrar) para conservar historial
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  articulos Article[]

  @@map("admins")
}

// ─── Content ────────────────────────────────────────────────────────────────

model Article {
  id               String   @id @default(uuid())
  slug             String   @unique
  title            String
  excerpt          String?
  content          String   @db.Text
  cover_image_url  String?
  published_at     DateTime?
  updated_at       DateTime @updatedAt
  meta_title       String?
  meta_description String?
  // Aportes de la comunidad (blog colaborativo)
  author_name      String?
  author_photo_url String?
  author_email     String?
  // Autor con cuenta propia (rol autor_blog). null = artículo MDX/comunidad/legacy.
  author_id        String?
  autor            Admin?   @relation(fields: [author_id], references: [id], onDelete: SetNull)
  created_at       DateTime @default(now())

  @@index([author_id])
  @@map("articles")
}

/// Registro de visitas a inmuebles (control de ingreso y seguridad).
/// Contiene datos personales sensibles (cédula), así que cada fila guarda la
/// PRUEBA del consentimiento: el momento exacto y las dos autorizaciones por
/// separado, como exige la Ley 1581 de 2012 (Habeas Data).
model Visita {
  id                    String   @id @default(uuid())
  createdAt             DateTime @default(now())
  nombresCompletos      String
  cedula                String
  // ── Inmueble visitado ──
  // `propiedadId` apunta al catálogo cuando el visitante elige una propiedad
  // nuestra. `inmuebleReferencia` SIEMPRE se llena: guarda el título elegido o
  // el texto libre si marcó "Otro". Así el registro sigue siendo legible aunque
  // la propiedad se borre del catálogo (la FK queda en NULL, el título no).
  propiedadId           String?
  propiedad             Property? @relation(fields: [propiedadId], references: [id], onDelete: SetNull)
  inmuebleReferencia    String // título de la propiedad elegida, o texto libre si esOtro
  esOtro                Boolean  @default(false) // inmueble no listado (de un colega)
  correo                String
  celular               String
  municipioOrigen       String
  // ── Prueba del consentimiento ──
  consentAt             DateTime // cuándo aceptó
  consentPolitica       Boolean  @default(false) // casilla 1: política de tratamiento
  consentControlIngreso Boolean  @default(false) // casilla 2: control de ingreso y seguridad
  ip                    String? // trazabilidad de seguridad; puede faltar

  @@index([createdAt])
  @@index([cedula])
  @@index([propiedadId]) // agrupación por inmueble en /admin/visitas
  @@map("visitas")
}

model Business {
  id              String   @id @default(uuid())
  nombre          String
  imagen_url      String?  // legacy: portada única (respaldo). Ahora se usa `imagenes`.
  imagenes        String[] @default([]) // hasta 5 fotos; imagenes[0] = portada
  descripcion     String?  // descripción corta
  categoria       String   // Restaurante | Ferretería | Droguería | Vivero | Otros
  municipio       String   @default("La Vega")
  whatsapp        String?
  domicilios      Boolean  @default(false)
  google_maps_url String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@index([categoria])
  @@index([municipio])
  @@map("businesses")
}

model PageContent {
  id         String   @id @default(uuid())
  key        String   @unique
  data       Json
  updated_at DateTime @updatedAt

  @@map("page_content")
}

model Redirect {
  id          String @id @default(uuid())
  source      String @unique
  destination String
  permanent   Boolean @default(true)

  @@map("redirects")
}

model SearchLog {
  id          String   @id @default(uuid())
  query       String?
  tipo        String?
  municipio   String?
  precio_max  BigInt?
  results     Int      @default(0)
  created_at  DateTime @default(now())

  @@map("search_logs")
}

// ─────────────────────────────────────────────────────────────────────────────
// Enlace privado para que el DUEÑO de una propiedad vea quién la visitó.
//
// La URL lleva un token largo aleatorio (la parte secreta) y encima pide un PIN
// que define el admin. Dos factores porque detrás hay cédulas: si el enlace se
// reenvía por WhatsApp sin querer, el PIN todavía protege los datos.
//
// El PIN se guarda SOLO hasheado con bcrypt — no hay forma de recuperarlo ni de
// mostrarlo. Si el dueño lo olvida, el admin genera un enlace nuevo.
//
// onDelete: Cascade (a diferencia de Visita, que usa SetNull): si la propiedad
// se borra del catálogo, el enlace del dueño pierde todo sentido y debe morir
// con ella. Lo que se preserva es el registro de la visita, no el acceso.
// ─────────────────────────────────────────────────────────────────────────────
model EnlaceVisitantes {
  id               String   @id @default(uuid())
  createdAt        DateTime @default(now())
  propiedadId      String
  propiedad        Property @relation(fields: [propiedadId], references: [id], onDelete: Cascade)
  token            String   @unique // 32 bytes aleatorios en base64url; parte secreta de la URL
  pinHash          String // bcrypt del PIN. NUNCA en texto plano
  expiraAt         DateTime // createdAt + 1 año
  revocado         Boolean  @default(false) // apagado manual desde el admin
  ultimoAcceso     DateTime? // trazabilidad: cuándo lo usó el dueño
  intentosFallidos Int      @default(0) // acumulado; al llegar al tope el enlace se bloquea

  @@index([propiedadId])
  @@map("enlaces_visitantes")
}

/// Medición manual de visibilidad en motores de IA.
///
/// Una fila = una consulta hecha a un motor en una fecha. El histórico se
/// construye repitiendo las MISMAS consultas de control (src/lib/visibilidad-ia.ts)
/// en cada ronda: si cambian, las mediciones dejan de ser comparables.
///
/// `consulta_id` y `motor` se guardan como texto, no como relación: su catálogo
/// vive en código a propósito, para que nadie lo edite desde el admin y rompa
/// la línea base.
model MedicionIA {
  id           String   @id @default(uuid())
  /// Id estable de la consulta de control (c01…c11).
  consulta_id  String
  /// Id del motor (chatgpt, gemini, claude, copilot, perplexity, deepseek).
  motor        String
  /// ¿Apareció Su Finca Raíz en la respuesta?
  aparece      Boolean
  /// Posición en la que se menciona (1 = primera). null si no aparece.
  posicion     Int?
  /// Competidores mencionados, en el orden en que aparecen.
  competidores String[]
  /// LO MÁS IMPORTANTE: cómo describió el motor a la marca, literal.
  /// Ahí se ve si resolvió la entidad correcta o la homónima de Rionegro.
  descripcion  String?  @db.Text
  /// Notas libres de quien mide.
  notas        String?  @db.Text
  medido_en    DateTime @default(now())
  medido_por   String?
  /// Commit desplegado en el momento de medir. Lo captura el servidor solo
  /// (VERCEL_GIT_COMMIT_SHA): sin esto, dentro de tres meses no se sabe contra
  /// qué versión del sitio se midió cada fila y la comparación pierde la mitad
  /// de su valor.
  commit_sitio String?
  /// Texto libre de quien mide: «tras retirar el gratis», «antes del reencuadre»…
  version_nota String?

  @@index([consulta_id, motor, medido_en])
  @@map("mediciones_ia")
}

/// Hallazgos de la vigilancia diaria de contenido (cron/vigilancia).
///
/// Existe para que el cron RECUERDE qué ya reportó: sin esto, el mismo hallazgo
/// se avisa cada día idéntico y un lead real se pierde entre las alertas. Cada
/// hallazgo se identifica por su `hash` (de clase+detalle); una corrida solo
/// notifica los NUEVOS o los que sigan abiertos tras N días. Cuando una corrida
/// ya no ve un hash, se marca `resuelto` (se corrigió).
model VigilanciaHallazgo {
  id            String    @id @default(uuid())
  /// sha1(clase ␀ detalle). Identidad estable del hallazgo.
  hash          String    @unique
  clase         String
  detalle       String    @db.Text
  primero_visto DateTime  @default(now())
  ultimo_visto  DateTime  @default(now())
  /// true cuando una corrida deja de verlo (contenido corregido).
  resuelto      Boolean   @default(false)
  /// Última vez que se avisó por WhatsApp de este hallazgo. null = nunca.
  notificado_en DateTime?

  @@index([resuelto, primero_visto])
  @@map("vigilancia_hallazgos")
}


// ═══════════════════════════════════════════════════════════════════════════
// MÓDULO TRIBUTARIO Y FINANCIERO
//
// PRINCIPIO: ninguna tarifa vive en el código ni en el esquema. Todas son
// parámetros por AÑO FISCAL, cargados desde el panel. Los campos nacen VACÍOS
// (nullable): si falta el parámetro del año, el cálculo se detiene y avisa.
// Es la misma regla del contenido: lo que cambia se deriva, no se escribe.
//
// QUÉ SE GUARDA Y QUÉ SE DERIVA:
//   · Se GUARDA lo que ocurrió: el IVA que se facturó y las retenciones que la
//     contraparte practicó (constan en su comprobante). Eso es un HECHO, no un
//     cálculo nuestro, y puede diferir de lo que calculamos.
//   · Se DERIVA siempre: valor neto, utilidad, bases gravables, totales.
//     Ningún total se persiste.
// ═══════════════════════════════════════════════════════════════════════════

enum TipoDocumento {
  CC
  NIT
  CE
  PPT
  PASAPORTE
  TI
}

enum TipoPersona {
  NATURAL
  JURIDICA
}

enum RolTercero {
  CLIENTE
  PROVEEDOR
  AMBOS
  ASESOR
}

enum EstadoIngreso {
  CAUSADO
  FACTURADO
  COBRADO
  ANULADO
}

/// Naturaleza del dinero recibido que NO es ingreso. Ver MovimientoCustodia.
enum NaturalezaCustodia {
  /// Arras o depósitos recibidos EN NOMBRE DEL VENDEDOR. Nunca son nuestros.
  DINERO_DE_TERCEROS
  /// Anticipo de honorarios propios SIN causación todavía (sin factura).
  ANTICIPO_PROPIO
}

enum EstadoCustodia {
  RECIBIDO
  ENTREGADO
  DEVUELTO
  APLICADO
}

enum RolParticipacion {
  PROPIA
  CORREDOR_EXTERNO
  ASESOR_INTERNO
}

/// Cliente o proveedor con identidad FISCAL. Distinto de `Contacto` (prospecto
/// del CRM): aquí el documento y las banderas del RUT son obligatorias porque
/// determinan qué retención aplica. Se enlaza opcionalmente con el contacto del
/// que salió, para no volver a teclear los datos.
model Tercero {
  id                    String       @id @default(uuid())
  tipo_documento        TipoDocumento
  numero_documento      String
  /// Dígito de verificación del NIT.
  dv                    String?
  /// Nombre completo o razón social.
  nombre                String
  tipo_persona          TipoPersona
  // ── Banderas del RUT. NO se infieren: se capturan del RUT del tercero. ──
  es_responsable_iva    Boolean      @default(false)
  es_autorretenedor     Boolean      @default(false)
  es_gran_contribuyente Boolean      @default(false)
  /// Determina si se aplica la tarifa de declarante o de no declarante.
  es_declarante_renta   Boolean      @default(false)
  regimen               String?
  direccion             String?
  /// Texto libre: el domicilio fiscal puede ser cualquier municipio del país,
  /// no solo los del Gualivá que tiene la tabla `municipalities`.
  municipio             String?
  telefono              String?
  email                 String?
  rol                   RolTercero   @default(CLIENTE)
  /// Puente OPCIONAL con el CRM. Nullable a propósito: un proveedor no es un
  /// contacto, y un contacto no necesita datos de RUT hasta que factura.
  contacto_id           String?      @unique
  contacto              Contacto?    @relation(fields: [contacto_id], references: [id], onDelete: SetNull)
  activo                Boolean      @default(true)
  notas                 String?      @db.Text
  created_at            DateTime     @default(now())
  updated_at            DateTime     @updatedAt

  ingresos              Ingreso[]
  egresos               Egreso[]
  participaciones       DistribucionComision[]
  custodiasRecibidas    MovimientoCustodia[]   @relation("CustodiaOrigen")
  custodiasEntregadas   MovimientoCustodia[]   @relation("CustodiaDestino")

  @@unique([tipo_documento, numero_documento])
  @@index([nombre])
  @@index([rol])
  @@map("terceros")
}

/// Parámetros fiscales de UN año. Nacen VACÍOS: el contador los llena.
model ParametroFiscal {
  id             String   @id @default(uuid())
  anio           Int      @unique
  /// Valor del UVT del año. Null = sin cargar → el cálculo se detiene.
  uvt            Decimal? @db.Decimal(14, 2)
  tarifa_iva     Decimal? @db.Decimal(5, 2)
  tarifa_reteiva Decimal? @db.Decimal(5, 2)
  /// Año cerrado: no se editan sus parámetros ni se registran movimientos.
  cerrado        Boolean  @default(false)
  notas          String?  @db.Text
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  conceptos      ConceptoRetencion[]
  tarifasIca     TarifaIca[]

  @@map("parametros_fiscales")
}

/// Retención por CONCEPTO y año. Tabla, no columnas fijas: los conceptos
/// cambian y no puede exigir migración añadir uno.
model ConceptoRetencion {
  id                   String  @id @default(uuid())
  parametro_id         String
  parametro            ParametroFiscal @relation(fields: [parametro_id], references: [id], onDelete: Cascade)
  /// honorarios | comisiones | servicios | arrendamiento | compras | …
  concepto             String
  label                String
  /// La tarifa depende de si el tercero declara renta.
  tarifa_declarante    Decimal @db.Decimal(5, 2)
  tarifa_no_declarante Decimal @db.Decimal(5, 2)
  /// Base mínima EN UVT. 0 = sin base mínima (se retiene desde el primer peso).
  base_minima_uvt      Decimal @db.Decimal(10, 2) @default(0)

  @@unique([parametro_id, concepto])
  @@map("conceptos_retencion")
}

/// Tarifa de ICA por municipio y año (por mil). Municipio como texto: se
/// declara donde se genera el ingreso, que puede estar fuera del Gualivá.
model TarifaIca {
  id             String  @id @default(uuid())
  parametro_id   String
  parametro      ParametroFiscal @relation(fields: [parametro_id], references: [id], onDelete: Cascade)
  municipio      String
  tarifa_por_mil Decimal @db.Decimal(6, 3)

  @@unique([parametro_id, municipio])
  @@map("tarifas_ica")
}

/// Catálogo de líneas de servicio. Tabla y no enum de Prisma: «configurable»
/// y `enum` son incompatibles —añadir un servicio no puede exigir migración—.
model TipoServicio {
  id                          String    @id @default(uuid())
  slug                        String    @unique
  label                       String
  /// Clave hacia ConceptoRetencion. Se guarda el CONCEPTO, nunca la tarifa.
  concepto_retencion_sugerido String?
  genera_iva                  Boolean   @default(true)
  orden                       Int       @default(0)
  activo                      Boolean   @default(true)
  ingresos                    Ingreso[]

  @@map("tipos_servicio")
}

model CategoriaEgreso {
  id                          String   @id @default(uuid())
  nombre                      String   @unique
  /// fijo | variable
  grupo                       String   @default("variable")
  es_deducible_por_defecto    Boolean  @default(true)
  genera_iva_descontable      Boolean  @default(true)
  /// Igual que en TipoServicio: el CONCEPTO de retención, no la tarifa.
  concepto_retencion_sugerido String?
  orden                       Int      @default(0)
  activo                      Boolean  @default(true)
  egresos                     Egreso[]

  @@map("categorias_egreso")
}

model Ingreso {
  id                    String       @id @default(uuid())
  tipo_servicio_id      String
  tipoServicio          TipoServicio @relation(fields: [tipo_servicio_id], references: [id])
  /// Las comisiones se atan a la propiedad vendida.
  property_id           String?
  property              Property?    @relation(fields: [property_id], references: [id], onDelete: SetNull)
  tercero_id            String
  tercero               Tercero      @relation(fields: [tercero_id], references: [id])
  /// Causación y recaudo son FECHAS DISTINTAS y ambas importan: la primera
  /// manda en renta e IVA, la segunda en el flujo de caja.
  fecha_causacion       DateTime
  fecha_recaudo         DateTime?
  valor_base            Decimal      @db.Decimal(16, 2)
  /// HECHOS del documento, no cálculos: el IVA facturado y lo que el cliente
  /// retuvo según su comprobante. El sistema calcula un sugerido y AVISA si
  /// difiere, pero guarda lo que realmente ocurrió.
  iva_generado          Decimal      @db.Decimal(16, 2) @default(0)
  retefuente_practicada Decimal      @db.Decimal(16, 2) @default(0)
  reteica_practicada    Decimal      @db.Decimal(16, 2) @default(0)
  reteiva_practicada    Decimal      @db.Decimal(16, 2) @default(0)
  /// Lo que el sistema CALCULÓ con los parámetros del año en el momento de
  /// registrar. Null = no se pudo calcular (faltaba el parámetro).
  /// La DISCREPANCIA no se guarda: se deriva de practicada − sugerida. Un
  /// cliente que retiene de más es dinero recuperable, y sin esto no habría
  /// forma de saberlo.
  iva_sugerido          Decimal?     @db.Decimal(16, 2)
  retefuente_sugerida   Decimal?     @db.Decimal(16, 2)
  reteica_sugerida      Decimal?     @db.Decimal(16, 2)
  reteiva_sugerida      Decimal?     @db.Decimal(16, 2)
  /// Por qué difiere, si se investigó (y si se reclamó).
  nota_discrepancia     String?      @db.Text
  // valor_neto_recibido NO existe como columna: se deriva siempre.
  numero_factura        String?
  /// CUFE de la factura electrónica emitida por el sistema DIAN que se use.
  cufe                  String?
  estado                EstadoIngreso @default(CAUSADO)
  /// Municipio donde se causa el ICA de este ingreso.
  municipio_ica         String?
  /// true = facturamos la comisión TOTAL (las partes ajenas son egreso);
  /// false = cada corredor facturó lo suyo y aquí va solo nuestra parte.
  facturamos_total      Boolean      @default(true)
  notas                 String?      @db.Text
  /// Id del Admin que lo registró. String sin FK, igual que Contacto.created_by.
  registrado_por        String?
  created_at            DateTime     @default(now())
  updated_at            DateTime     @updatedAt

  distribuciones        DistribucionComision[]
  custodiasAplicadas    MovimientoCustodia[]

  @@index([fecha_causacion])
  @@index([fecha_recaudo])
  @@index([estado])
  @@index([property_id])
  @@index([tercero_id])
  @@map("ingresos")
}

model Egreso {
  id                       String          @id @default(uuid())
  categoria_id             String
  categoria                CategoriaEgreso @relation(fields: [categoria_id], references: [id])
  /// NULLABLE a propósito: un peaje o un tanque de gasolina se captura en tres
  /// toques y muchas veces sin tercero identificado. Se completa después.
  tercero_id               String?
  tercero                  Tercero?        @relation(fields: [tercero_id], references: [id], onDelete: SetNull)
  fecha                    DateTime
  descripcion              String
  valor_base               Decimal         @db.Decimal(16, 2)
  iva_descontable          Decimal         @db.Decimal(16, 2) @default(0)
  /// Las que YO le practico al proveedor (y luego declaro y pago).
  retefuente_practicada    Decimal         @db.Decimal(16, 2) @default(0)
  reteica_practicada       Decimal         @db.Decimal(16, 2) @default(0)
  reteiva_practicada       Decimal         @db.Decimal(16, 2) @default(0)
  /// Lo calculado con los parámetros del año al registrar. Aquí la
  /// discrepancia significa que RETUVIMOS MAL nosotros: o se le debe al
  /// proveedor, o se le debe a la DIAN. Ambas hay que verlas.
  iva_sugerido             Decimal?        @db.Decimal(16, 2)
  retefuente_sugerida      Decimal?        @db.Decimal(16, 2)
  reteica_sugerida         Decimal?        @db.Decimal(16, 2)
  reteiva_sugerida         Decimal?        @db.Decimal(16, 2)
  nota_discrepancia        String?         @db.Text
  // valor_pagado NO existe como columna: se deriva.
  /// No todo gasto real es deducible fiscalmente.
  es_deducible             Boolean         @default(true)
  property_id              String?
  property                 Property?       @relation(fields: [property_id], references: [id], onDelete: SetNull)
  soporte_url              String?
  metodo_pago              String?
  numero_factura_proveedor String?
  registrado_por           String?
  created_at               DateTime        @default(now())
  updated_at               DateTime        @updatedAt

  distribucion             DistribucionComision?

  @@index([fecha])
  @@index([categoria_id])
  @@index([property_id])
  @@index([tercero_id])
  @@map("egresos")
}

/// DINERO QUE ENTRA Y NO ES INGRESO — arras y anticipos.
///
/// Entidad SEPARADA, no una bandera en Ingreso, y es deliberado: con una
/// bandera, la fila sigue viviendo en `ingresos` y cada consulta, suma y
/// reporte tendría que acordarse de excluirla. Un `WHERE` olvidado infla la
/// base gravable y produce un impuesto que no se debe. En tabla aparte, el
/// error es estructuralmente imposible.
///
/// REGLA: aquí solo entra dinero SIN causación. En el momento en que hay
/// causación (se emite factura, se presta el servicio), deja de ser custodia y
/// nace un Ingreso — con su IVA y sus retenciones. Por eso este modelo no
/// tiene campos de IVA: si los necesitara, ya no era custodia.
model MovimientoCustodia {
  id                     String             @id @default(uuid())
  naturaleza             NaturalezaCustodia
  /// arras, depósito de seriedad, anticipo de honorarios…
  concepto               String
  tercero_id             String
  tercero                Tercero            @relation("CustodiaOrigen", fields: [tercero_id], references: [id])
  property_id            String?
  property               Property?          @relation(fields: [property_id], references: [id], onDelete: SetNull)
  fecha_recibido         DateTime
  valor                  Decimal            @db.Decimal(16, 2)
  estado                 EstadoCustodia     @default(RECIBIDO)
  fecha_cierre           DateTime?
  /// A quién se le entregó, si era dinero de terceros.
  entregado_a_tercero_id String?
  entregadoA             Tercero?           @relation("CustodiaDestino", fields: [entregado_a_tercero_id], references: [id], onDelete: SetNull)
  /// Si terminó reconociéndose como ingreso nuestro (anticipo causado, o arras
  /// retenidas que nos corresponden), apunta al Ingreso que lo reconoce.
  ingreso_id             String?
  ingreso                Ingreso?           @relation(fields: [ingreso_id], references: [id], onDelete: SetNull)
  soporte_url            String?
  notas                  String?            @db.Text
  registrado_por         String?
  created_at             DateTime           @default(now())
  updated_at             DateTime           @updatedAt

  @@index([estado])
  @@index([property_id])
  @@index([tercero_id])
  @@map("movimientos_custodia")
}

/// COMISIÓN COMPARTIDA. Las filas suman SIEMPRE la comisión total de la
/// operación, incluida nuestra parte (rol = PROPIA). Lo que cambia según el
/// escenario es qué se factura:
///   · facturamos_total = true  → Ingreso.valor_base es el TOTAL y cada parte
///     ajena genera un Egreso (con la retención que le practicamos).
///   · facturamos_total = false → Ingreso.valor_base es SOLO nuestra parte y
///     las ajenas son informativas: no tocan la base gravable, pero sí sirven
///     para la rentabilidad real de la operación.
model DistribucionComision {
  id            String           @id @default(uuid())
  ingreso_id    String
  ingreso       Ingreso          @relation(fields: [ingreso_id], references: [id], onDelete: Cascade)
  /// Null cuando la fila es nuestra parte (rol = PROPIA).
  tercero_id    String?
  tercero       Tercero?         @relation(fields: [tercero_id], references: [id], onDelete: SetNull)
  rol           RolParticipacion
  porcentaje    Decimal?         @db.Decimal(5, 2)
  valor         Decimal          @db.Decimal(16, 2)
  /// Si facturamos el total, la parte ajena se paga y es egreso nuestro.
  genera_egreso Boolean          @default(false)
  egreso_id     String?          @unique
  egreso        Egreso?          @relation(fields: [egreso_id], references: [id], onDelete: SetNull)
  notas         String?

  @@index([ingreso_id])
  @@map("distribuciones_comision")
}
