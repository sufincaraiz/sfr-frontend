# ──────────────────────────────────────────────────────────────
# Su Finca Raíz — Frontend — Variables de entorno
# Copia este archivo como .env.local y completa los valores reales
# NUNCA commitees .env.local al repositorio
# ──────────────────────────────────────────────────────────────

# URL del backend API (en producción usar la URL de tu servidor/Railway/Render)
NEXT_PUBLIC_API_URL=http://localhost:4000

# URL pública del sitio (sin trailing slash)
NEXT_PUBLIC_SITE_URL=https://www.sufincaraiz.com

# Cloudinary — cloud name público (safe para frontend)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name

# Cloudinary — upload preset sin firma (creado en Cloudinary Dashboard > Settings > Upload)
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# Google Search Console — código de verificación (optional)
NEXT_PUBLIC_GSC_VERIFICATION=

# Upstash Redis — rate limiting distribuido de /api/agent (server-only)
# Requeridas: si faltan, /api/agent rechaza las peticiones (falla cerrado).
# Se obtienen en https://console.upstash.com (base Redis > REST API)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Alerta de nuevo lead por WhatsApp al asesor (plantilla "nuevo_lead_sfr", es_CO).
# Destinatario en formato E.164 (ej: +573218826730). Si está vacía, la alerta NO se
# intenta (el código queda dormido hasta configurar la variable y aprobar la plantilla).
# Reutiliza WHATSAPP_PHONE_NUMBER_ID y WHATSAPP_ACCESS_TOKEN del webhook.
ALERT_WHATSAPP_TO=

# ─── Identidad tributaria (secretos en Vercel: Production y Preview) ──────────
# Salen del RUT y NO van en el código. Sin ellas el módulo financiero funciona,
# pero los reportes salen marcados «NO VÁLIDO PARA DECLARAR» con el dato
# PENDIENTE a la vista: nunca se inventa un NIT.
# Si EMPRESA_NIT y EMPRESA_NIT_DV no cuadran entre sí, `next build` FALLA
# (la valida next.config.ts con el algoritmo módulo 11 de la DIAN).
EMPRESA_NIT=
EMPRESA_NIT_DV=
EMPRESA_RAZON_SOCIAL=
